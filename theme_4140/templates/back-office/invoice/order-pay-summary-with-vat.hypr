<div class="order-invoice-right-section">
    <div class="order-row">
        <div class="label-heading">{{labels.totalBeforeVATDiscount}} <br/> <span class="tbd">الإجمالي قبل الخصم</span></div>
        <div class="label-text">{{model.currencyCode}} {{order.data.order_TotalBeforeVATDiscount|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
    <div class="order-row">
        <div class="label-heading">{{labels.discount}} {{labels.vatExcluding}}<br/> <span class="discountArabic"> تخفيض </span> </div>
        <div class="label-text">{{model.currencyCode}} {{order.discountTotal|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
    <div class="order-row">
        <div class="label-heading">{{labels.invoiceDeliveryBlob}} {{labels.vatIncluding}}<br/> <span class="dcArabic">رسوم التوصيل</span> </div>
        <div class="label-text">{{model.currencyCode}} {{order.shippingTotal|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
    <div class="order-row">
        <div class="label-heading">{{labels.subtotal}} {{labels.vatExcluding}}<br/> <span class="stArabic">المجموع الفرعي</span></div>
        <div class="label-text">{{model.currencyCode}} {{order.data.orderSubTotal_excl_VAT|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
    <div class="order-row">
        <div class="label-heading">{{labels.total}} {{labels.vat}}</div>
        <div class="label-text">{{model.currencyCode}} {{model.data.order_TotalVatAmount|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
    <div class="order-row last-row">
        <div class="bottom-row"></div>
    </div>
    <div class="order-row total-amount">
        <div class="label-heading">{{labels.total}} {{labels.vatIncluding}}<br/> <span class="totalArabic">المجموع</span> </div>
        <div class="label-text">{{model.currencyCode}} {{order.data.orderTotal|floatformat(pageContext.currencyInfo.precision)}}</div>
    </div>
</div> 