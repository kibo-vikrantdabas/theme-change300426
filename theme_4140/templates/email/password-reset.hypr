{% extends "email/email" %}
{% block body-content %}

<!--[if mso]>
 
  <div style="text-align:center;margin:30px 0;">
    <img src="https://cdn-tp1.euw1.kibocommerce.com/100067-m1/cms/files/cd619a01-49ed-49eb-9bf6-714a3688ee07" alt="MS-Logo" style="width: 103px;height: 39px;" width="103" height="39">
  </div>
  <div class="emailPadding">
	{% if model and model.firstName %}
  <p style="margin-bottom:24px; font-size:14px;">{{ labels.emailOpeningHi|string_format(model.firstName)|safe }}</p>
	{% else %}
  <p style="margin-bottom:24px; font-size:14px;">{{ labels.emailOpeningAlternativeHi|safe }}</p>
	{% endif %}

  <p style="margin:20px 0;line-height:21px;">{{ labels.emailPasswordTop|string_format(model.userName)|safe }}</p>
  <p style="margin:20px 0;line-height:21px;">{{ labels.emailPasswordBottom|string_format(siteContext.generalSettings.websiteName)|safe }}</p>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="padding: 20px 0; display: inline-block;">
    <tr>
        <td style="background: #BED855;">
          <a style="background:#BED855;color:#333;font-size:16px;text-decoration:none; line-height: 15px; padding: 13px 17px;font-weight:600;" href="https://{{themeSettings.localeDomain}}/user/resetpasswordconfirm?t={{model.ValidationToken }}&u={{model.UserId}}">{{ labels.resetPassword|safe }}</a>
        </td>
    </tr>
  </table>
    <table style="margin:0 0 50px 0; color: #fff; text-align: center; width:100%;" width="100%" >
            <tr>
                <td>
                    <table cellpadding="0" cellspacing="0" border="0" width="100%"  style="border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:20px 0" >
                    <tr > 
                        <td width="32%" style="padding:20px 0;text-align:center;">
                        <a href="https://{{themeSettings.localeDomain}}/contact" target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{labels.contactUs|safe }}</a>
                        </td>
                        <td width="32%" style="padding:0;border-right:1px solid #ccc;border-left:1px solid #ccc;text-align:center;">
                        <a href="https://{{themeSettings.localeDomain}}/return-refund"  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{ labels.returnsAndRefunds|safe}}</a>
                        </td>
                        <td width="32%" style="padding:0;text-align:center;">
                        <a href="https://{{themeSettings.localeDomain}}/terms-conditions"  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{ labels.termsAndConditions|safe}}</a>
                        </td>
                    </tr>
                
                </table>
                </td>
            </tr>
       
        </table>
        {% comment %} <div style="width:50%;">
          <table cellpadding="0" cellspacing="0" border="0" width="100%" >
            <tr>
              <td style="margin-left:120px;text-align: center;">
                <a href="https://www.facebook.com/MarksandSpencerME">
              <img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/facebook.png"></a>
              </td>
              <td  style="text-align: center;">
                <a href="https://www.youtube.com/user/MandSArabia"><img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/youtube.png"></a>
              </td>
              <td  style="text-align: center;margin-right:120px;">
           
                 <a  href="https://www.instagram.com/marksandspencerme"><img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/instagram.png"></a>
              </td>
            </tr>
          </table>
        </div> {% endcomment %}
        <div style="text-align:center; font-size:10px; line-height:16px">
    <p style="color:#000">
      <a style="padding:20px" href="https://www.facebook.com/MarksandSpencerME" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="4"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/facebook.png"></a> 
      <a style="padding:20px" href="https://www.youtube.com/user/MandSArabia" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="5"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/youtube.png"></a>
      <a style="padding:20px" href="https://www.instagram.com/marksandspencerme" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="6"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/instagram.png"></a>
    </p>
  </div>
  <div style="text-align:center;font-size:10px; line-height:20px; font-family: Arial, Helvetica, sans-serif;">
    <p style="color:#000">
      {{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}<br />{{themeSettings.emailFooterAddress2}}
    </p>
  </div>

