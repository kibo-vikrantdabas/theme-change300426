  {% extends "email/email" %}

  {% block body-content %}
  	<div style="width: 100%; max-width:490px; font-family: Arial, Helvetica, sans-serif;">
		<table width="100%">
			<tr> 
				<td style="text-align:center;margin:30px 0; padding-bottom:32px;">
					<img src="https://{{themeSettings.localeDomain}}{{themeSettings.emailBannerImage}}" alt="MS-Logo"/>
				</td>
			</tr>
			<tr>
				<td style="padding: 20px 77px; background-color: #163E35; color: #fff; text-align: center; font-size: 21px; font-family: Arial, Helvetica, sans-serif;">
					{{ labels.refundInitTitle}}
				</td>
			</tr>
		</table>
		
		<table style="font-size: 14px; line-height: 28px; margin-top: 32px;" width="100%">
			<tr style="margin: 0;">
				<td style="font-family: Arial, Helvetica, sans-serif; padding:0"><strong>{{ labels.orderNumber }}:</strong> {{ model.order.orderNumber }}</td>
				<td style="font-family: Arial, Helvetica, sans-serif; padding:0"></td>
			</tr>
			<tr style="margin: 0;"> 
				<td style="padding-bottom:20px; font-family: Arial, Helvetica, sans-serif; padding:0"><strong>{{ labels.orderDate }}:</strong> {% include "modules/common/date-time-format" with dateTimeFormatInput=model.order.submittedDate %}</td>
				<td style="font-family: Arial, Helvetica, sans-serif; padding:0"></td>
			</tr>
			<tr style="font-size: 14px; letter-spacing: 0;	line-height: 18px; color: #000;	margin: 0;">
				<td style="padding-bottom: 20px; font-family: Arial, Helvetica, sans-serif; padding:20px 0px 0px 0px;">
					{% if user and user.firstName %}
						{{ labels.emailOpening|string_format(user.firstName)|safe }}
					{% else %}
						{{ labels.emailOpeningAlternative|safe }}
					{% endif %}
				</td>
			</tr>
			<tr style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;">
				<td style="font-family: Arial, Helvetica, sans-serif; padding:20px 0px 30px 0px;">
					{{ labels.refundInitText }}
				</td>
			</tr>
		</table>

		<table style="background: #163E35; color: #fff; text-align: center; max-width:490px;" width="100%">
			<tr>
				<td style="font-size: 16px; letter-spacing: 0; line-height: 21px; margin: 0; padding: 26px 0 5px; font-family: Arial, Helvetica, sans-serif;">{{ labels.needHelp }}</td>
			</tr>
			<tr>
				<td style="font-size: 12px; letter-spacing: 0; line-height: 16px; margin: 0; padding: 0 60px 30px; font-family: Arial, Helvetica, sans-serif;">{{ labels.getInTouch|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}</td>
			</tr>
		</table>
		
		<div style="margin:30px 0 30px 0;border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:10px 0;width:100%;max-width:490px;" >
			<table cellpadding="0" cellspacing="0" border="0" width="100%" >
				<tr> 
					<td width="32%" style="padding:0;text-align:center;">
					<a href="https://{{themeSettings.localeDomain}}/contact" target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{labels.contactUs|safe }}</a>
					</td>
					<td width="32%" style="padding:0;border-right:1px solid #ccc;border-left:1px solid #ccc;text-align:center;">
					<a href="https://{{themeSettings.localeDomain}}return-refund"  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{ labels.returnsAndRefunds|safe}}</a>
					</td>
					<td width="32%" style="padding:0;text-align:center;">
					<a href="https://{{themeSettings.localeDomain}}/terms-conditions"  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">{{ labels.termsAndConditions|safe}}</a>
					</td>
				</tr>
			</table>

			<div style="text-align:center; font-size:10px; line-height:16px">
				<p style="color:#000">
				  <a style="padding:10px" href="https://www.facebook.com/MarksandSpencerME" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="4"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/facebook.png"></a> 
				  <a style="padding:10px" href="https://www.youtube.com/user/MandSArabia" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="5"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/youtube.png"></a>
				  <a style="padding:10px" href="https://www.instagram.com/marksandspencerme" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="6"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/instagram.png"></a>
				</p>
			  </div>

			<div style="text-align:center;font-size:10px; line-height:20px; border-top: 1px solid #ccc; margin-top: 10px;font-family: Arial, Helvetica, sans-serif;"><p style="color:#000">{{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}</p></div>
		</div>
	</div>

  {% endblock body-content %}
