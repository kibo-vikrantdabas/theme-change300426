            <span style="font-family: Arial, Helvetica, sans-serif;">{{ model.orderNumber }} / {{ model.shipmentNumber }}</span>
        </div>
        <div class="mz-orderheader-date-value" style="margin: 0;">
            <span style="font-family: Arial, Helvetica, sans-serif;"><strong>{{ labels.orderDateEmail }}:</strong></span>
