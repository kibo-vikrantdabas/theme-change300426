    </div>
    <span style="padding: 20px 77px;line-height:normal; background-color: #163E35; color: #fff; display: block; text-align: center; font-size: 21px; margin-bottom: 32px; max-width:490px; font-family: Arial, Helvetica, sans-serif;" class="mz-order-shipped-confirmation-title">{{labels.orderConfirmationMailTitle}}</span>
    <div class="mz-orderheader-created" style="font-size: 14px; line-height: 28px;">
