{% extends "email/email" %}

{% block body-content %}
{% set_var brandDetails model.data.brandDetails %}
{% set_var paymentDetails model.data.paymentDetails %}
<style>
li{
    padding-left: 8px;
}
</style>

<!--[if mso]>

<div class="mz-email-template-product-instock" style="max-width:490px;font-family: Arial, Helvetica, sans-serif!important;">
        <div style="text-align:center;margin:30px 0;">            
            <img src="https://cdn-tp1.euw1.kibocommerce.com/100067-m1/cms/files/cd619a01-49ed-49eb-9bf6-714a3688ee07" alt="MS-Logo" style="width: 103px;height: 39px;" width="103" height="39">
        </div>

        <table align="center" width="650" cellpadding="0" cellspacing="0" border="0" style="table-layout: fixed;background-color:#fff;">
            <tbody>
                    <tr align="center" >
                        <td colspan="2" style="text-align:center; height: 64px; width:490px; vertical-align:middle; background-color: #163E35; color: #ffffff; font-size: 21px; line-height: 24px;font-weight: 600;letter-spacing: 0;font-family: Arial, Helvetica, sans-serif;">
                            {{labels.orderPickupReadyMainTitle}} 
                        </td>
                    </tr>

                    <tr align="left">
                        <td style="padding-left:0px;padding-top: 30px; padding-bottom: 0;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"> 
                            <span style="font-weight:600;"> {{ labels.orderShipmentNumberEmail }}: </span> {{ model.orderNumber }} 
                        </td>
                    </tr>

                    <tr align="left">
                        <td style="padding-left:0px;padding-bottom: 0;padding-top:6px;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                         <span style="font-weight:600;"> {{ labels.orderDateEmail }}: </span> {% include "modules/common/date-time-format" with dateTimeFormatInput=model.orderSubmitDate %} </td>
                    </tr>
                    
            </tbody>
        </table>

        <div style="margin-bottom:27px; width:100%;font-family: Arial, Helvetica, sans-serif;">
            <p style="margin-bottom:28.2px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;">
                {{ labels.emailOpeningHi| string_format(model.destination.destinationContact.fullName) }}
            </p>
            {% if model.siteId == 100300 or  model.siteId == 100299 %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBodyAE|string_format(location.name)|safe }}
                </p>
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2AE }}
                </p>
            {% endif %}

            {% if model.siteId == 100167 or  model.siteId == 100166 %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBodyKW|string_format(location.name)|safe }}
                </p>
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2KW }}
                </p>
            {% endif %}
            {% if model.siteId != 100299  and   model.siteId != 100300  and  model.siteId != 100166 and  model.siteId != 100167 %}
                {% with model.storeLocation as location %}
                    <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{ labels.orderPickupReadyMainBody|string_format(locat100300ion.name)|safe }}
                    </p>
                {% endwith %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2 }}
                </p>
             {% endif %}

        </div>
       
       <div style="width:100%;font-family: Arial, Helvetica, sans-serif;">
            <span style='font-size:12px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;font-family: Arial, Helvetica, sans-serif;'>
            {{ labels.returnCreatedWhatHappendNext1|safe }}
            <span>

            {% if model.siteId == 100300 or  model.siteId == 100299 or  model.siteId == 100167 or  model.siteId == 100166 %}
            <ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;margin:0;font-family: Arial, Helvetica, sans-serif;'>
                <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                    {{ labels.orderPickupReadyWhatHappenedNext1AE|safe }}
                </li>
                <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                    {{ labels.orderPickupReadyWhatHappenedNext2AE|safe }}
                </li>  
            </ul>
            {% else %}
            <ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;margin:0;font-family: Arial, Helvetica, sans-serif;'>
                <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                    {{ labels.orderPickupReadyWhatHappenedNext1|safe }}
                </li>
                <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                    {{ labels.orderPickupReadyWhatHappenedNext2|safe }}
                </li>  
            </ul>
            {% endif %}
          
           
       </div>

       <div>
            <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;border-bottom:0.1px solid #cccccc;"> 
                {{ labels.orderShippedDetails }}
            </p>
       </div>

       <table align="center" width="650" cellpadding="0" cellspacing="0" border="0" style="table-layout: fixed;background-color:#fff;">
            <tbody>
                <tr align="left">
                    <td  width="100%" style="padding-left:0px;"> 
                            <table cellpadding="0" cellspacing="0" border="0" width="100%" id="producttable" style="padding-left:0px;padding-top:0px;">
                                <tbody style="padding-left:0px;padding-top:0px;">
                                {% for item in model.items %}	
                                    <tr style="padding-left:0px;padding-top:0px;font-family: Arial, Helvetica, sans-serif;" >
                                        <td align="left"  style="padding:0;vertical-align: middle;">
                                            <img src="https:{{ item.imageUrl }}" width="83.87" height="100" />
                                        </td>
                                        <td style="padding:0; text-align: left; vertical-align: middle;font-family: Arial, Helvetica, sans-serif;">
                                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px;font-family: Arial, Helvetica, sans-serif;">
                                                {% for property in item.product.properties %}
                                                    {% if property.values and not property.isHidden %}
                                                        {%if property.name == 'Brand' %}
                                                            {% for v in property.values %}
                                                                {% if v.stringValue %}{{v.stringValue}}{% else %}{{v.value}}{% endif %}
                                                            {% endfor %}
                                                        {% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            </p>
                                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px;text-align: left;font-family: Arial, Helvetica, sans-serif;">
                                                {{ item.name }}
                                            </p>
                                            <p> 
                                                {% if item.options %}
                                                    {% for option in item.options %}
                                                    
                                                        {% if option.value %}
                                                            {{ option.stringValue|default(value.value)}}
                                                            {% if forloop.last == false %},{% endif%}
                                                        {% else %}
                                                            {{ option.shopperEnteredValue }}
                                                            {% if forloop.last == false %},{% endif%}
                                                        {% endif %}
                                                        
                                                        {% endfor %}
                                                {% endif %}
                                            </p> 
                                            <p style="font-size: 14px;letter-spacing: 0;text-align: left;font-family: Arial, Helvetica, sans-serif;">
                                                {{labels.qty}}: {{ item.quantity }}
                                            </p>
                                        </td>
                                        <td align="right" style="float:right; padding: 0px 0 0 15px; font-size: 14px; letter-spacing: 0; line-height: 18px; vertical-align: top;font-family: Arial, Helvetica, sans-serif;">
                                            {{model.currencyCode}} {{item.actualPrice|multiply(item.quantity)|floatformat(pageContext.currencyInfo.precision) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                    </td>
                </tr>
                    
            </tbody>
        </table>






        <div style="width:100%;padding-bottom:20px;">
            <table cellpadding="0" cellspacing="0" border="0" style="width:100%">
                <tr align="left">
                    <td width="100%" style="padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
                    </td>
                </tr>
            </table>
        </div>

        <div>
        <p style="font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;" class="mz-desktop-display">{{ labels.orderSummary }}<p>
    </div>

    <table cellpadding="0" cellspacing="0" border="0" width="650" style="table-layout: fixed;background-color:#fff;">
        <tbody>
            <tr width="650" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                <td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    <p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                        {{ labels.subtotal }}
                    </p>
                </td> 
                <td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    <p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                        {{model.currencyCode}} {{model.lineItemSubtotal}} 
                    <p>
                </td>
            </tr>
            <tr width="650" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                <td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    <p style="font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                        {{ labels.deliveryCost}}
                    </p>
                </td> 
                <td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                     {% if  model.shippingTotal > 0  %}
                        <p style="float:right;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                            {{model.currencyCode}} {{ model.shippingTotal }}
                        <p>
                    {% else %}
                        <p style="float:right;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                            {{labels.costFree}}
                        <p>
                    {% endif %} 
                </td>
            </tr>
        </tbody>
    </table>
   
    <div style="width:100%;padding-top:0px;">
        <table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             <tr align="left">
                <td width="100%" style="padding-top:0px;padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
                </td>
            </tr>
        </table>
    </div>

     <div style="width:100%;padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
        <table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             <tr align="left">
               <td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    <p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                        {{ labels.total }}
                    </p>
                </td> 
                <td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    <p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
                        {{model.currencyCode}} {{model.total}} 
                    <p>
                </td>
            </tr>
        </table>
    </div>

    <div style="width:100%;padding-top:0px;">
        <table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             <tr align="left">
                <td width="100%" style="padding-top:0px;padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
                </td>
            </tr>
        </table>
    </div>

    <div>
        <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">
            {{ labels.paymentMethod }}
        </p>
        <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">
            {{ model.destination.destinationContact.firstName }} {{  model.destination.destinationContact.lastNameOrSurname }}<br />
            {{labels.orderPickupPaidThrough}}
        </p>
    </div>
        
    <div>
        <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.contactDetails }}</p>
        <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">
            {{labels.contactFullName}}: {{ model.destination.destinationContact.fullName }} <br />
            {{labels.mobile}}: {% if model.destination.destinationContact.phoneNumbers.mobile != null or model.destination.destinationContact.phoneNumbers.mobile != "" %} {{ model.destination.destinationContact.phoneNumbers.mobile }} {% else %}  {{ model.destination.destinationContact.phoneNumbers.home}} {% endif %}
         </p>
    </div>

    <div style="margin-bottom: 20px">
        <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 21px; font-family: Arial, Helvetica, sans-serif;">{{ labels.pickupReadyWhatBring }}</p>
        <span style="margin: 0; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{ labels.pickupReadyWhatbring1|safe }}<span>
        <ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;'>
            {{ labels.pickupReadywhatbringList|safe }}
        </ul>
	</div>

    <div style="margin-bottom: 20px">
        <span style="margin: 0; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{ labels.pickupReadyWhatbringB|safe }}<span>
        <ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;'>
            {{ labels.pickupReadywhatbringListB|safe }}
        </ul>
	</div>

        <div style="padding-bottom: 30px; margin-bottom: 30px">
        <table style="background: #163E35; color: #fff; text-align: center;" width="100%">
            <tr>
                <td style="font-size: 16px; letter-spacing: 0; line-height: 21px; margin: 0; padding: 26px 0 5px; font-family: Arial, Helvetica, sans-serif;" width="490">
                    {{ labels.needHelp }}
                </td>
            </tr>
            <tr>
                <td style="font-size: 12px; letter-spacing: 0; line-height: 16px; margin: 0; padding: 0 12% 20px; font-family: Arial, Helvetica, sans-serif;" width="490">
                    {% if model.siteId == 100300 or  model.siteId == 100299 or model.siteId == 100460 or model.siteId == 100461 or model.siteId == 100150 or model.siteId == 100151 or model.siteId == 100375 or model.siteId == 100376  %}
                        {{ labels.getInTouchAE|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}
                    {% endif %}
                    {% if model.siteId == 100167 or  model.siteId == 100166 or model.siteId == 100148 or model.siteId == 100149 or model.siteId == 100371 or model.siteId == 100374 or model.siteId == 100379 or model.siteId == 100380 or model.siteId ==  100447 or model.siteId ==  100448 or model.siteId ==  100454 or model.siteId ==  100455 %}
                        {{ labels.getInTouchKW|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}
                     {% endif %}
                     {% if  model.siteId == 100443 or model.siteId == 100444 or model.siteId == 100331 or model.siteId == 100330 %}
                        {{ labels.getInTouchKSA|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}
                     {% endif %}
                     {% if model.siteId != 100299  and   model.siteId != 100300  and  model.siteId != 100166 and  model.siteId != 100167 and model.siteId != 100443 and model.siteId != 100444 and model.siteId != 100331 and model.siteId != 100330 and model.siteId != 100150 and model.siteId != 100151 and model.siteId != 100375 and model.siteId != 100376 and model.siteId != 100148 and model.siteId != 100149 and model.siteId != 100371 and model.siteId != 100374 and model.siteId != 100379 and model.siteId != 100380 %}
                        {{ labels.getInTouch|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}
                     {% endif %}
                </td>
            </tr>
            {% if themeSettings.countrySpecificCode|lower != 'sa' %}
                <tr>  
                    <table bgcolor="#BED855"  style="width:283px;color:#333!important;  font-size: 16px;font-weight: bold;  letter-spacing: 0;line-height: 21px; text-align: center;padding: 14px 16px 0; margin: 0 auto;">
                        <a href="https://{{themeSettings.localeDomain}}/return-refund" style="text-decoration:none;color:#333 !important; font-family: Arial, Helvetica, sans-serif;">
                            {{labels.returnButtonText}}
                        </a>
                    </table>
                </tr>
            {% endif %}
            <tr><td style="padding-bottom: 2px;"></td></tr>
        </table>
    </div>
    
    <table cellpadding="0" cellspacing="0" border="0" width="490px" style="margin:20px 0 20px 0;border-top:1px solid #ccc;border-bottom:1px solid #ccc;">
        <tr> 
            <td width="32%" style="text-align:center;letter-spacing: 0;font-weight: 600;font-size: 10px;line-height: 13px;">
                <a href="https://{{themeSettings.localeDomain}}/contact"" target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">
                    {{labels.contactUs|safe }}
                </a>
            </td>

            <td style="padding-left:20px;padding-right:20px;">
                <span style="text-align:center;">|</span>
            </td>

            <td width="32%" style="text-align:center;letter-spacing: 0;font-weight: 600;font-size: 10px;line-height: 13px;">
                <a href="https://{{themeSettings.localeDomain}}/return-refund""  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">
                    {{ labels.returnsAndRefunds|safe}}
                </a>
            </td>

             <td style="padding-left:20px;padding-right:20px;">
                <span style="text-align:center;">|</span>
            </td>

            <td width="32%" style="text-align:center;">
                <a href="https://{{themeSettings.localeDomain}}/terms-conditions""  target="_blank" style="font-size:10px;text-decoration:none;color:#000;font-family: Arial, Helvetica, sans-serif;">
                    {{ labels.termsAndConditions|safe}}
                </a>
            </td>
        </tr>
    </table>

    <div style="text-align:center;font-size:10px; line-height:20px;width:100%; font-family: Arial, Helvetica, sans-serif;">
        <p style="color:#000">
            {{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}<br />{{themeSettings.emailFooterAddress2}}
        </p>
    </div>
</div>

<![endif]-->
<!--[if !mso]> <!---->




<div class="mz-email-template-order-confirmation" style="max-width:490px;font-family: Arial, Helvetica, sans-serif!important;">
        <div style="text-align:center;margin:30px 0;">
            <img src="https://cdn-tp1.euw1.kibocommerce.com/100067-m1/cms/files/cd619a01-49ed-49eb-9bf6-714a3688ee07" alt="MS-Logo" style="width: 103px;height: 39px;" width="103" height="39">
        </div>
		<span style="padding: 20px 77px;line-height:normal; background-color: #163E35; color: #fff; display: block; text-align: center; font-size: 21px; margin-bottom: 32px; max-width:490px;font-family: Arial, Helvetica, sans-serif;" class="mz-order-shipped-confirmation-title">
            {{ labels.orderPickupReadyMainTitle }}
        </span>
		<div class="mz-orderheader-created" style="font-size: 14px; line-height: 28px;font-family: Arial, Helvetica, sans-serif;">
            <div class="mz-orderheader-order-value" style="margin: 0;font-family: Arial, Helvetica, sans-serif;">
                <span style="font-family: Arial, Helvetica, sans-serif; color:#000"><strong>{{ labels.orderShipmentNumberEmail }}:</strong></span>
                <span style="font-family: Arial, Helvetica, sans-serif;color:#000">{{ model.orderNumber }} </span>
            </div>
            <div class="mz-orderheader-date-value" style="margin: 0;font-family: Arial, Helvetica, sans-serif;">
                <span style="font-family: Arial, Helvetica, sans-serif;color:#000"><strong>{{ labels.orderDateEmail }}:</strong></span>
                <span style="font-family: Arial, Helvetica, sans-serif;color:#000">{% include "modules/common/date-time-format" with dateTimeFormatInput=model.orderSubmitDate %}</span>
            </div>
       </div>
  
        <br>
        
        <div style="margin-bottom:27px; width:100%;font-family: Arial, Helvetica, sans-serif;">
            <p style="margin-bottom:28.2px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                {{ labels.emailOpeningHi| string_format(model.destination.destinationContact.fullName) }}
            </p>

            {% if model.siteId == 100300 or  model.siteId == 100299 %}
              {% with model.storeLocation as location %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBodyAE|string_format(location.name)|safe }}
                </p>
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2AE }}
                </p>
                 {% endwith %}
            {% endif %}

            {% if model.siteId == 100167 or  model.siteId == 100166 %}
               {% with model.storeLocation as location %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBodyKW|string_format(location.name)|safe }}
                </p>
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2KW }}
                </p>
                  {% endwith %}
            {% endif %}

            {% if model.siteId != 100299  and   model.siteId != 100300  and  model.siteId != 100166 and  model.siteId != 100167 %}
                {% with model.storeLocation as location %}
                    <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;margin-bottom:0px;font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{ labels.orderPickupReadyMainBody|string_format(location.name)|safe }}
                    </p>
                {% endwith %}
                <p style="font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;color:#000">
                    {{ labels.orderPickupReadyMainBody2 }}
                </p>
             {% endif %}

            
        </div>
       
       <div style="width:100%;font-family: Arial, Helvetica, sans-serif;">
            <span style='font-size:12px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;font-family: Arial, Helvetica, sans-serif;'>
            {{ labels.returnCreatedWhatHappendNext1|safe }}
            </span>
            {% if model.siteId == 100300 or  model.siteId == 100299 or  model.siteId == 100167 or  model.siteId == 100166 %}
				<ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;margin:0;font-family: Arial, Helvetica, sans-serif;'>
					<li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
						{{ labels.orderPickupReadyWhatHappenedNext1AE|safe }}
					</li>
					<li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
						{{ labels.orderPickupReadyWhatHappenedNext2AE|safe }}
					</li>  
				</ul>
            {% else %}
                <ul {% if themeSettings.isArabicLanguageSite%}style='padding-right:40px; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;margin:0;font-family: Arial, Helvetica, sans-serif;'{% else %} style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;margin:0;font-family: Arial, Helvetica, sans-serif;'{% endif %}>
                    <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                        {{ labels.orderPickupReadyWhatHappenedNext1|safe }}
                    </li>
                    <li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
                        {{ labels.orderPickupReadyWhatHappenedNext2|safe }}
                    </li>  
                </ul>
             {% endif %}   
       </div>

       <div style="border-top: 1px solid #ccc; margin-top: 20px ; width:100%;font-family: Arial, Helvetica, sans-serif;">
            <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;" class="mz-desktop-display">{{ labels.orderShippedDetails }}<p>
            <table class="mz-ordersummary" style="background: transparent; width: 100%; font-family: Arial, Helvetica, sans-serif;">
                <thead></thead>
            <tbody style="width:100%; font-family: Arial, Helvetica, sans-serif;">
                {% for item in model.items %}	
                {% set_var isBrandAvailable=true %}	
                    <tr class="mz-ordersummary-line mz-ordersummary-line-item" style="border-bottom:0.1px solid #cccccc; width:490px; font-family: Arial, Helvetica, sans-serif;">
                        <td {% if themeSettings.isArabicLanguageSite%}style="padding: 20px 0 20px 16px; width:83px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="padding: 20px 16px 20px 0; width:83px; font-family: Arial, Helvetica, sans-serif;"{% endif %}><img src="https:{{ item.imageUrl }}" width="83.87" height="118" /></td>
                        <td {% if themeSettings.isArabicLanguageSite%}style="text-align:right; padding: 0 10px; vertical-align: top; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:left; padding: 0 10px; vertical-align: top; font-family: Arial, Helvetica, sans-serif;"{% endif %}>
                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 20px 0 5px; font-family: Arial, Helvetica, sans-serif;color:#000">
                               {% set_var productCode item.productCode %}
                              {% for brandDetail in brandDetails %}
                                  {%if brandDetail.code == productCode %}
                                      {{brandDetail.brand}}
                                {% endif %}
                              {% endfor %}
                            </p>
                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000">{{ item.name }}</p>
                            <p> 
                                {% if item.options %}
                                    <dl class="mz-propertylist">
                                        <dd class="mz-propertylist-data" {% if themeSettings.isArabicLanguageSite%}style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:12px; margin-right: 0; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:0; margin-right: 12px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>
                                        {% for option in item.options %}
                                    
                                        {% if option.value %}
                                            {{ option.stringValue|default(value.value)}}
                                            {% if forloop.last == false %},{% endif%}
                                        {% else %}
                                            {{ option.shopperEnteredValue }}
                                            {% if forloop.last == false %},{% endif%}
                                        {% endif %}
                                        
                                        {% endfor %}
                                    </dd>
                                    </dl>
                                {% endif %}
                            </p>
                            <p style="font-size: 14px; letter-spacing: 0; font-family: Arial, Helvetica, sans-serif;color:#000">{{labels.qty}}: {{ item.quantity }}</p>
                        </td>
                          <td {% if themeSettings.isArabicLanguageSite%} style="float:left; vertical-align:top ; text-align:left; {% if isBrandAvailable %} padding: 43px 15px 0 0; {% else %} padding: 20px 15px 0 0;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;  color:#000"{% else %} style="float:right; text-align:right; vertical-align:top; {% if isBrandAvailable %} padding: 43px 0 0 15px; {% else %} padding: 20px 0 0 15px;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{model.currencyCode}} {{item.actualPrice|multiply(item.quantity)|floatformat(pageContext.currencyInfo.precision) }}
                             <br>
                            <p>&nbsp;</p>
                            <p style="font-size: 14px; letter-spacing: 0; font-family: Arial, Helvetica, sans-serif; color: #015642; ">{{ labels.orderReadyPickupItemTxt}}</p>
                        </td>
                    </tr>	
                {% endfor %}

                {% if model.siteId == 100300 or model.siteId == 100299 or model.siteId == 100166 or  model.siteId == 100167 %}
                  {% if model.canceledItems %} 
                            {% for item in model.canceledItems %}	
                {% set_var isBrandAvailable=true %}
                 
                    <tr class="mz-ordersummary-line mz-ordersummary-line-item" style="border-bottom:0.1px solid #cccccc; width:490px; font-family: Arial, Helvetica, sans-serif;">
                        <td {% if themeSettings.isArabicLanguageSite%}style="padding: 20px 0 20px 16px; width:83px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="padding: 20px 16px 20px 0; width:83px; font-family: Arial, Helvetica, sans-serif;"{% endif %}><img src="https:{{ item.imageUrl }}" width="83.87" height="118" /></td>
                        <td {% if themeSettings.isArabicLanguageSite%}style="text-align:right; padding: 0 10px; vertical-align: top; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:left; padding: 0 10px; vertical-align: top; font-family: Arial, Helvetica, sans-serif;"{% endif %}>
                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 20px 0 5px; font-family: Arial, Helvetica, sans-serif;color:#000">
                                {% set_var productCode item.productCode %}
                              {% for brandDetail in brandDetails %}
                                  {%if brandDetail.code == productCode %}
                                      {{brandDetail.brand}}
                                {% endif %}
                              {% endfor %}
                            </p>
                            <p style="font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000">{{ item.name }}</p>
                            <p> 
                                {% if item.options %}
                                    <dl class="mz-propertylist">
                                        <dd class="mz-propertylist-data" {% if themeSettings.isArabicLanguageSite%}style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:12px; margin-right: 0; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:0; margin-right: 12px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>
                                        {% for option in item.options %}
                                    
                                        {% if option.value %}
                                            {{ option.stringValue|default(value.value)}}
                                            {% if forloop.last == false %},{% endif%}
                                        {% else %}
                                            {{ option.shopperEnteredValue }}
                                            {% if forloop.last == false %},{% endif%}
                                        {% endif %}
                                        
                                        {% endfor %}
                                    </dd>
                                    </dl>
                                {% endif %}
                            </p>
                            <p style="font-size: 14px; letter-spacing: 0; font-family: Arial, Helvetica, sans-serif;color:#000">{{labels.qty}}: {{ item.quantity }}</p>
                        </td>
                        <td {% if themeSettings.isArabicLanguageSite%} style="float:left; vertical-align:top; text-align:left; {% if isBrandAvailable %} padding: 43px 15px 0 0; {% else %} padding: 20px 15px 0 0;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; vertical-align:top; text-align:right; {% if isBrandAvailable %} padding: 43px 0 0 15px; {% else %} padding: 20px 0 0 15px;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>
                            {{model.currencyCode}} {{item.actualPrice|multiply(item.quantity)|floatformat(pageContext.currencyInfo.precision) }}
                            <br>
                            <p>&nbsp;</p>
                            <p style="font-size: 14px; letter-spacing: 0; font-family: Arial, Helvetica, sans-serif; color: #A6192E; ">{{ labels.orderReadyCancelledItemTxt}}</p>
                        </td>
                    </tr>	
                {% endfor %}
                   {% endif %}
                 {% endif %}
                
                </tbody>

                <tfoot style="width:100%; font-family: Arial, Helvetica, sans-serif;">
                    <tr>
                        <td style="padding: 25px 0 0 0; width: 100px; font-size: 14px; letter-spacing: 0; line-height: 16px; float:left; font-family: Arial, Helvetica, sans-serif;color:#000">{{ labels.orderSummary }}</td> 
                        <td></td>
                    </tr>
                    <tr class="mz-ordersummary-subtotal">
                        <td colspan="4" style="padding: 20px 0 10px 0">
                        <span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; padding-right:0; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{ labels.subtotal }}</span>
                        <span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{model.currencyCode}} {{model.lineItemSubtotal|floatformat(pageContext.currencyInfo.precision)}}</span>
                        </td>
                    </tr>
                    <tr class="mz-ordersummary-shippingtotal">
                        <td colspan="4" style="padding: 0 0 10px 0">
                        <span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; padding-right:0; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{ labels.deliveryCost }}</span>
                        {% if  model.shippingTotal > 0  %}
                        <span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{model.currencyCode}} {{ model.shippingTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
                    {% else %}
                    <span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{labels.costFree}}</span>
                    {% endif %}   
                    </td>
                    </tr>
                    <tr class="mz-ordersummary-grandtotal">
                        <td colspan="4" style="border-top: 1px solid #cccccc; border-bottom: 0.1px solid #cccccc; padding: 10px 0; font-family: Arial, Helvetica, sans-serif;">
                            <span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; padding-right:0; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{ labels.total }}</span>
                            <span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{model.currencyCode}} {{ model.total|floatformat(pageContext.currencyInfo.precision) }}</span>
                        </td>
                    </tr>
                </tfoot>
            </table>
       </div>

       <div>
            <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">
                {{ labels.paymentMethod }}
            </p>
            <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">
                {{ model.destination.destinationContact.firstName }} {{  model.destination.destinationContact.lastNameOrSurname }}<br />
                {{labels.paymentThrough}} 
							
                            {% if paymentDetails %} 
                                {% for payment in paymentDetails %} 
                                    {% if (payment.paymentSource == "MC" or payment.paymentSource == "VISA" or payment.paymentSource == "AMEX") %}  
                                         {{labels.creditCard}}
                                    {% endif %}
                                    {% if payment.paymentSource == "BL" %} 
                                        {{labels.blueWalletPayment}} 
                                    {% endif %}
                                    {% if payment.paymentSource == "benefitwallet" %} 
                                        {{labels.paidThroughBenefitPay}} 
                                    {% endif %}
                                    {% if payment.paymentSource == "qpaywallet" %} 
                                        {{labels.paidThroughQpay}} 
                                    {% endif %}
                                    {% if payment.paymentSource == "applepay" %} 
                                        {{labels.paidThroughCreditCardApplePay}} 
                                    {% endif %}
                                    {% if payment.paymentSource == "omanwallet" %} 
                                        {{labels.paidThroughOmanNet}} 
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            
                          
            </p>
        </div>
        
        <div>
            <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;color:#000">{{ labels.contactDetails }}</p>
            <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">
                {{labels.contactFullName}}: {{ model.destination.destinationContact.fullName }} <br />
                {{labels.mobile}}: {% if model.destination.destinationContact.phoneNumbers.mobile != null or model.destination.destinationContact.phoneNumbers.mobile != "" %} {{ model.destination.destinationContact.phoneNumbers.mobile }} {% else %}  {{ model.destination.destinationContact.phoneNumbers.home }} {% endif %}
            </p>
        </div>
            
        {% if model.storeLocation  %}
            {% with model.storeLocation as location %}
                <div>
                    <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{ labels.selectedstore }}
                    </p>
                    <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{ location.name }} <br />
                        {{location.address.address1}},{{location.address.cityOrTown}}<br />
                        {{location.address.countryCode}}
                    </p> 
                </div>
                <div>
                    <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{ labels.openingHours }}
                    </p>
                    <p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">
                        {{location.regularHours.sunday.openTime}} {{labels.to}} {{location.regularHours.sunday.closeTime}} {{ labels.daily }}
                    </p>
                </div>
           {% endwith %}
        {% endif %}
         
    
      <div style="margin-bottom: 20px">
            <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 21px; font-family: Arial, Helvetica, sans-serif;color:#000">
                {{ labels.pickupReadyWhatBring }}
            </p>
            <span style="margin: 0; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">
                {{ labels.pickupReadyWhatbring1|safe }}
            <span>
            <ul  {% if themeSettings.isArabicLanguageSite%}style='padding-right:40px; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000'{% else %} style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000'{% endif %}>
               {{ labels.pickupReadywhatbringList|safe }}
            </ul>
	  </div>

      <div style="margin-bottom: 20px">
            <span style="margin: 0; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;color:#000">{{ labels.pickupReadyWhatbringB|safe }}<span>
            <ul  {% if themeSettings.isArabicLanguageSite%}style='padding-right:40px; font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000'{% else %} style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin: 0; font-family: Arial, Helvetica, sans-serif;color:#000'{% endif %}>
                {{ labels.pickupReadywhatbringListB|safe }}
            </ul>
	  </div>

      <div style="background-color: #163E35; color: #fff; text-align: center; margin-top: 30px; width:100%; {% if themeSettings.countrySpecificCode|lower != 'sa' %} height:125px; {% else %} height:125px; {% endif %}"> 
            <div style="margin:0 auto;width: 490px">
                <p style="font-size: 16px; letter-spacing: 0; line-height: 21px; margin: 0;  padding-top: 30px; font-family: Arial, Helvetica, sans-serif;">
                    {{ labels.needHelp }}
                </p>
                <p style="font-size: 12px; letter-spacing: 0; line-height: 16px; margin: 0 auto; padding-top: 3px;min-width:283px;max-width: 415px; font-family: Arial, Helvetica, sans-serif; color:#FFF;">
                     {% if model.siteId == 100300 or  model.siteId == 100299 or model.siteId == 100460 or model.siteId == 100461 or model.siteId == 100150 or model.siteId == 100151 or model.siteId == 100375 or model.siteId == 100376 %}
                        {{ labels.getInTouchAE|string_format(themeSettings.storephonenumber, themeSettings.storeopentime,themeSettings.storeclosetime)|safe }}
                     {% endif %}
                     {% if model.siteId == 100167 or  model.siteId == 100166 or model.siteId == 100148 or model.siteId == 100149 or model.siteId == 100371 or model.siteId == 100374 or model.siteId == 100379 or model.siteId == 100380 or model.siteId ==  100447 or model.siteId ==  100448 or model.siteId ==  100454 or model.siteId ==  100455 %}
                        {{ labels.getInTouchKW|string_format(themeSettings.storephonenumber, themeSettings.storeopentime,themeSettings.storeclosetime)|safe }}
                     {% endif %}
                     {% if  model.siteId == 100443 or model.siteId == 100444 or model.siteId == 100331 or model.siteId == 100330 %}
                        {{ labels.getInTouchKSA|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}
                     {% endif %}
                     {% if model.siteId != 100299  and   model.siteId != 100300  and  model.siteId != 100166 and  model.siteId != 100167 and model.siteId != 100443 and model.siteId != 100444 and model.siteId != 100331 and model.siteId != 100330 and model.siteId != 100150 and model.siteId != 100151 and model.siteId != 100375 and model.siteId != 100376 and model.siteId != 100148 and model.siteId != 100149 and model.siteId != 100371 and model.siteId != 100374 and model.siteId != 100379 and model.siteId != 100380 %}
                        {{ labels.getInTouch|string_format(themeSettings.storephonenumber, themeSettings.storeopentime,themeSettings.storeclosetime)|safe }}
                     {% endif %}
                </p>
            </div>
      </div>

      <div style="margin:30px 0 30px 0;border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:10px 0;width:100%;">
        <table cellpadding="0" cellspacing="0" border="0" width="490px" >
            <tr>
                <td width="32%" style="padding:0;text-align:center;">
                 <a href="https://{{themeSettings.localeDomain}}/contact" target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif!important;">{{labels.contactUs|safe }}</a>
                </td>
                <td width="32%" style="padding:0;border-right:1px solid #ccc;border-left:1px solid #ccc;text-align:center;">
                 <a href="https://{{themeSettings.localeDomain}}/return-refund"  target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.returnsAndRefunds|safe}}</a>
                </td>
                <td width="32%" style="padding:0;text-align:center;">
                  <a href="https://{{themeSettings.localeDomain}}/terms-conditions"  target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.termsAndConditions|safe}}</a>
                </td>
              </tr>
         </table>
     </div>
    <div style="margin: 0 auto;width:50%;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" >
            <tr>
                <td style="padding-right:10px;text-align:end;">
                    <a href="https://www.facebook.com/MarksandSpencerME"><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/facebook.png"></a>
                </td>
                <td  style="text-align: center;">
                    <a href="https://www.youtube.com/user/MandSArabia"><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/youtube.png"></a>
                </td>
                <td  style="padding-right:0px;padding-left:10px">           
                    <a  href="https://www.instagram.com/marksandspencerme"><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/instagram.png"></a>
                </td>
            </tr>
        </table>
    </div>
    <div style="text-align:center;font-size:10px; line-height:20px;width:100%; font-family: Arial, Helvetica, sans-serif;">
        <p style="color:#000">
            {{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}<br />{{themeSettings.emailFooterAddress2}}
        </p>
    </div>
</div>

<!-- <![endif]-->

{% endblock body-content %}