{% extends "email/email" %}

{% block body-content %}
{% set_var webcounter=0 %}
{% set_var counter=0 %}
	{% if model.shipmentType == "Curbside" or model.shipmentType == "BOPIS_Curbside" %}
	
	{% else %}
	{% if model.shipmentType == "STH" %}
		{% set_var isCashOnDelivery=false %}

	<!--[if mso]>
	  <div class="mz-email-template-order-shipped"style="max-width:490px;font-family: Arial, Helvetica, sans-serif;">
		<div style="text-align:center;margin:30px 0;"><img src="https://{{themeSettings.localeDomain}}{{themeSettings.emailBannerImage}}" alt="MS-Logo"/></div>
		<table width="100%" style="margin-bottom: 40px !important;">
            <tr>
				{% if model.rejectedItems%}
				 <td style="padding: 20px 57px; background-color: #163E35; color: #fff; text-align: center; font-size: 21px; font-family: Arial, Helvetica, sans-serif; line-height: normal;" width="600">
				    {{ labels.orderPartialShippedConfirmedTitle }}
			    </td>
				{% else %}
				  <td style="padding: 20px 77px; background-color: #163E35; color: #fff; text-align: center; font-size: 21px; font-family: Arial, Helvetica, sans-serif; line-height: normal;" width="600">
				    {{ labels.orderShippedConfirmedTitle }}
			    </td>
				{% endif %}
			  
			</tr>
        </table>
		<table>
			<tr>
				<td style="padding-left:0px;padding-top: 30px; padding-bottom: 0;><span style="font-family: Arial, Helvetica, sans-serif;"><strong>{{ labels.orderNumber }}:</strong></span> {{ model.orderNumber}} </td>
			</tr>
			<tr>
				<td style="padding-left:0px;padding-top: 30px; padding-bottom: 0;><span style="font-family: Arial, Helvetica, sans-serif;"><strong>{{ labels.orderDate }}:</strong></span>{% include "modules/common/date-time-format" with dateTimeFormatInput=model.orderSubmitDate %}</td>
			</tr> 
			<tr align="left">
				<td style="padding-left:0px;padding-bottom: 0; padding-top: 10px;font-size: 14px; letter-spacing: 0; line-height: 18px; color: #000; font-family: Arial, Helvetica, sans-serif;">
					{{ labels.emailOpeningOrderShipped|string_format(model.destination.destinationContact.firstName)|safe }}</td>
			</tr>
			<tr align="left">
				{% if model.rejectedItems %}
				{{ labels.orderShippedTextforPartialShipment }}</td>
				{%else%}
				<td style="padding-left:-40px;padding-top: 20px;font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;">
				{{ labels.orderShippedText }}</td>
				{%endif%}
			</tr>
			<tr>
				<td style="padding-left:0px;padding-top: 0px;padding-bottom:5px;font-family: Arial, Helvetica, sans-serif;">{{ labels.returnCreatedWhatHappendNext1|safe }}</td>
            </tr>
			<tr>
				<td style="padding-left:40px;padding-bottom:0px;padding-top: 0px;font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;">
					<ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
						{{ labels.orderShippedWhatHappendNext2|string_format(domainName)|safe }}
					</ul>
				</td>
			</tr>
			{% comment %} <tr align="left">
                <td width="100%" style="padding-left:0px;padding-bottom:10px;border-top: 1px solid #ccc;">          
            </td> {% endcomment %}
		</table>
		<div style="border-top: 1px solid #ccc; padding-top: 20px">
			<p style="margin-top:20px;font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px;font-family: Arial, Helvetica, sans-serif;" class="mz-desktop-display">{{ labels.orderShippedDetails }}<p>
            <table class="mz-ordersummary" style="background: transparent; width: 100%;">
				<thead></thead>
			<tbody>
				{% for item in model.items %}		
					<tr class="mz-ordersummary-line mz-ordersummary-line-item" style="padding-left:0px;padding-top:0px;border-bottom:0.1px solid #cccccc;">
						<td align="left" style="padding: 20px 16px 20px 0; width:83px;font-family: Arial, Helvetica, sans-serif;"><img src="https:{{ item.imageUrl }}" width="83.87" height="108" /></td>
						<td style="text-align:right; padding: 0 10px; vertical-align: baseline;">
							<p style="font-family: Arial, Helvetica, sans-serif;font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 20px 0 5px;">
								{% for property in item.data.properties %}
									{% if property.values and not property.isHidden %}
										{%if property.name == 'Brand' %}
											{% for v in property.values %}
												{% if v.stringValue %}{{v.stringValue}}{% else %}{{v.value}}{% endif %}
											{% endfor %}
										{% endif %}
									{% endif %}
								{% endfor %}
							</p>
							<p style="text-align:left;font-family: Arial, Helvetica, sans-serif;font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 0;">{{ item.name }}</p>
							<p> 
								{% if item.options %}
										{% for option in item.options %}

										{% if option.value %}
											{{ option.stringValue|default(value.value)}}
											{% if forloop.last == false %}, Size {% endif%}
										{% else %}
											{{ option.shopperEnteredValue }}
											{% if forloop.last == false %},{% endif%}
										{% endif %}
					
										{% endfor %}
								{% endif %}
								{% if item.quantity %}
								    <p class="mz-propertylist-quantity" style="font-size: 14px;letter-spacing: 0;text-align: left;font-family: Arial, Helvetica, sans-serif;">
									    {{labels.qty}}: {{item.quantity}}
									</p>
								{% endif %}
							</p>
							{% for reason in item.reasons %}
							<p style="font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">{{labels.qty}}: {{ reason.quantity }}</p>
							{% endfor %}
						</td>
						<td style="float:right; padding: 20px 0 0 15px; font-size: 14px; letter-spacing: 0; line-height: 18px; width:84px; font-family: Arial, Helvetica, sans-serif;"> {{siteContext.currencyInfo.currencyCode}} {{item.overridePrice|default(item.unitPrice)|floatformat(2}}</td>
					</tr>	
				{% endfor %}
			</tbody>
			</table>
			<div style="width:100%;padding-bottom:20px;">
        		<table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             		<tr align="left">
                		<td width="100%" style="padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
                		</td>
            		</tr>
        		</table>
   			</div>
			<div>
				<p style="font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">{{ labels.orderSummary }}</p> 
			</div>	
			    <table cellpadding="0" cellspacing="0" border="0" width="650" style="table-layout: fixed;background-color:#fff;">		
					<tbody>
 						<tr width="650" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                			<td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    			<p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{ labels.subtotal }}</p>
                			</td> 
							{% for item in model.items %}	
                			<td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                    			<p style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{siteContext.currencyInfo.currencyCode}} {{item.lineItemCost|floatformat(pageContext.currencyInfo.precision)}} <p>
                			</td>
							{% endfor %}
            			</tr>					
						<tr class="mz-ordersummary-shippingtotal" width="650" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
							<td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
								<p class="mz-ordersummary-totalname" style="font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{ labels.deliveryCost }}</p>
							</td>
							 <td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
                       		{% if  model.shippingTotal > 0  %}
								<p class="mz-ordersummary-totalvalue" style="float:right;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{siteContext.currencyInfo.currencyCode}} {{ model.shippingTotal|floatformat(pageContext.currencyInfo.precision) }}</p>
							{% else %}
                        		<p class="mz-ordersummary-totalvalue" style="float:right;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{labels.free}}</span>
                        	{% endif %}  
                       		</td>
						</tr>
					</tbody>
				</table>	
				<div style="width:100%;padding-top:0px;">
        			<table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             			<tr align="left">
                			<td width="100%" style="padding-top:0px;padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
               				</td>
            			</tr>
        			</table>
    			</div>
				<div style="width:100%;padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
					<table cellpadding="0" cellspacing="0" border="0" style="width:100%">
						<tr align="left" class="mz-ordersummary-grandtotal">
							<td align="left" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">
								<p class="mz-ordersummary-totalname" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{ labels.total }}</p>
							</td>
							<td align="right" width="300" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;">	
								<p class="mz-ordersummary-totalvalue" style="padding-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;font-weight: 500;font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{siteContext.currencyInfo.currencyCode}} {{model.total|floatformat(pageContext.currencyInfo.precision)}}</p>
							</td>
						</tr>
					</table>
				</div>
				<div style="width:100%;padding-top:0px;">
        			<table cellpadding="0" cellspacing="0" border="0" style="width:100%">
             			<tr align="left">
              			  	<td width="100%" style="padding-top:0px;padding-left:0px;padding-bottom:0px;border-top: 1px solid #ccc;">         
                			</td>
            			</tr>
        			</table>
   				 </div>
		    <div>
				<div class="mz-paymentdetails">
			     	<p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.paymentDetails }}</p>
						<p style="font-size: 14px; letter-spacing: 0;   line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{model.destination.destinationContact.firstName }} {{ model.destination.destinationContact.lastNameOrSurname }}<br/>
						{{labels.paymentThrough}} 
							{% for payment in model.order.payments %}
				     			{% if payment.billingInfo %}
									{% if payment.status != "Voided" and payment.status != "Declined" %}
										{% if payment.billingInfo.paymentType == 'CreditCard' and payment.billingInfo.card.paymentOrCardType != 'BLUEPREPAIDCARD' %} 
											{% if counter == 0 %}
               									{% set_var counter=1 %}
													Credit Card
											{% endif %}
										{% else %} {% if payment.billingInfo.paymentType|lower == 'check'%} {% set_var isCashOnDelivery=true %} {{labels.cashOnDelivery}} {% endif %} {% endif %}
										{% if payment.billingInfo.paymentType == 'token' and payment.billingInfo.token.type|lower == "bluewallet" %}  {{labels.blueWalletPayment}} {% endif %}
										{% if payment.billingInfo.card and payment.billingInfo.card.paymentOrCardType == 'BLUEPREPAIDCARD' and not isCashOnDelivery %}  {{labels.bluePrepaidPayment}} {% endif %}  
									{% endif %}
								{% endif %}
					        {% endfor %}
						</p>
				</div>
				<div class="mz-deliverydetails">
					<p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.deliveryDetails }}</p>
					<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">
					    {% if  model.destination.destinationContact.address %}
					    {{  model.destination.destinationContact.address.address1}}<br/>
						{{ model.destination.destinationContact.address.cityOrTown}}<br/>
						{{ model.destination.destinationContact.address.stateOrProvince}}, {{ model.destination.destinationContact.address.countryCode}}
				    	{% endif %}
					</p>
				</div>	
				<div class="mz-contactdetails">
				    <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.contactDetails }}</p>
					<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{labels.contactFullName}}: {{model.destination.destinationContact.firstName }} {{ model.destination.destinationContact.lastNameOrSurname }}<br />
                    {{labels.mobile}}: {{model.destination.destinationContact.phoneNumbers.home}} </p>
				</div>
			</div>
		</div>
		<div style="background: #163E35; color: #fff; height:123px; text-align: center; margin-top: 30px;margin-bottom:30px width:490;">
			<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background: #163E35; color: #fff; height:170px; text-align: center;>
			<tr>
			<td style="font-size: 16px; letter-spacing: 0; line-height: 21px; margin: 0; padding: 20px 0 5px; font-family: Arial, Helvetica, sans-serif;" width="490">{{ labels.needHelp }}</td>
			</tr>
			<tr>
                <td style="font-size: 12px; letter-spacing: 0; line-height: 16px; margin: 0; padding: 0 12% 10px; font-family: Arial, Helvetica, sans-serif;" width="490">{{ labels.getInTouch|string_format(themeSettings.storephonenumber, themeSettings.storeopentime, themeSettings.storeclosetime)|safe }}</td>
            </tr>
			 {% comment %} <tr>
                <td>
                <table bgcolor="#BED855" style="width:283px;color:#333!important;  font-size: 16px;font-weight: bold;  letter-spacing: 0;line-height: 21px; text-align: center;padding: 14px 16px 0; margin: 0 auto;"><a href="https://{{themeSettings.localeDomain}}/return-refund" style="text-decoration:none;color:#333 !important;font-family: Arial, Helvetica, sans-serif;">{{labels.returnButtonText}}</a>
                </table>
                </td>            
            </tr> 
			   <tr>  
                <td bgcolor="#163E35" style="padding:10px 0;"></td>
            </tr>{% endcomment %}
			</table>
		</div>
		<div style="margin:15px 0 20px 0;border-bottom:1px solid #ccc !important;">
     		<table cellpadding="0" cellspacing="0" border="0" width="100%">
      			<tr><td></td>
      			</tr>
     		</table>
      	</div>
		<div style="margin:30px 0 30px 0;border-top:1px solid #ccc !important;border-bottom:1px solid #ccc;padding:10px 0;width:100%;">
			<table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-top:1px solid #ccc;">
			<tr> 
				<td width="32%" style="text-align:center;">
				<a href="https://{{themeSettings.localeDomain}}/contact" target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif;">{{labels.contactUs|safe }}</a>
				</td>
				<td style="padding-left:20px;padding-right:20px;">
                <span style="text-align:center;">|</span>
            	</td>
				<td width="32%" style="padding:0;text-align:center;">
				<a href="https://{{themeSettings.localeDomain}}/return-refund"  target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif;">{{ labels.returnsAndRefunds|safe}}</a>
				</td>
				<td style="padding-left:20px;padding-right:20px;">
                <span style="text-align:center;">|</span>
            	</td>
				<td width="32%" style="text-align:center;">
				<a href="hhttps://{{themeSettings.localeDomain}}/terms-conditions"  target="_blank" style="font-size:10px;text-decoration:none;color:#000; font-family: Arial, Helvetica, sans-serif;">{{ labels.termsAndConditions|safe}}</a>
				</td>
			</tr>
			</table>
		</div>
		<div style="width:50%;">
          <table cellpadding="0" cellspacing="0" border="0" width="100%" >
            <tr>
              <td style="margin-left:120px;text-align: center;">
                <a href="https://www.facebook.com/MarksandSpencerME">
              <img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/facebook.png"></a>
              </td>
              <td  style="text-align: center;">
                <a href="https://www.youtube.com/user/MandSArabia"><img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/youtube.png"></a>
              </td>
              <td  style="text-align: center;margin-right:120px;">
           
                 <a  href="https://www.instagram.com/marksandspencerme"><img  src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/instagram.png"></a>
              </td>
            </tr>
          </table>
        </div>
        <div style="text-align:center;font-size:10px; line-height:20px; font-family: Arial, Helvetica, sans-serif;"><p style="color:#000">{{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}</p></div>
	</div>
	<![endif]-->
	<!--[if !mso]> <!---->
	{% set_var totalDiscount=0 %}
    <div class="mz-email-template-order-shipped"style="max-width:490px;font-family: Arial, Helvetica, sans-serif;">
		<div style="text-align:center;margin:30px 0;"><img src="https://{{themeSettings.localeDomain}}{{themeSettings.emailBannerImage}}" alt="MS-Logo"/></div>
		{% if model.rejectedItems %}
		<span style="padding: 28px 57px;line-height:normal; background-color: #163E35; color: #fff; display: block; text-align: center; font-size: 21px; margin-bottom: 32px; max-width:490px; font-family: Arial, Helvetica, sans-serif; " class="mz-order-shipped-confirmation-title">{{labels.orderPartialShippedConfirmedTitle}}</span>
		{%else%}
		<span style="padding: 20px 77px;line-height:normal; background-color: #163E35; color: #fff; display: block; text-align: center; font-size: 21px; margin-bottom: 32px; max-width:490px; font-family: Arial, Helvetica, sans-serif;" class="mz-order-shipped-confirmation-title">{{labels.orderShippedConfirmedTitle}}</span>
		{%endif%}
		<div class="mz-orderheader-created" style="font-size: 14px; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">
			<div class="mz-orderheader-order-value" style="margin: 0;">
				<span style="font-family: Arial, Helvetica, sans-serif;"><strong>{{ labels.orderNumber }}:</strong></span>
				<span style="font-family: Arial, Helvetica, sans-serif;">{{ model.orderNumber}}</span>
			</div>
			<div class="mz-orderheader-date-value" style="margin: 0;">
				<span style="font-family: Arial, Helvetica, sans-serif;"><strong>{{ labels.orderDate }}:</strong></span>
				<span style="font-family: Arial, Helvetica, sans-serif;">{% include "modules/common/date-time-format" with dateTimeFormatInput=model.orderSubmitDate %}</span>
			</div>
		</div>
		<div style="font-family: Arial, Helvetica, sans-serif;"> 
			<p style="font-size: 14px; letter-spacing: 0; line-height: 18px; color: #000; margin: 20px 0; font-family: Arial, Helvetica, sans-serif;">
			{{ labels.emailOpeningOrderShipped|string_format(model.destination.destinationContact.firstName)|safe }}</p>
			{% if model.rejectedItems %}
			<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin-bottom: 20px; font-family: Arial, Helvetica, sans-serif;">{{ labels.orderShippedTextforPartialShipment }}</p>
			{% else  %}
			<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; margin-bottom: 20px; font-family: Arial, Helvetica, sans-serif;">{{ labels.orderShippedText }}</p>
	        {% endif %}
		</div>
		<div style="font-family: Arial, Helvetica, sans-serif;">
			<span style="font-family: Arial, Helvetica, sans-serif;">{{ labels.returnCreatedWhatHappendNext1|safe }}</span>
			<ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;'>
				{{ labels.orderShippedWhatHappendNext2|string_format(domainName)|safe }}
			</ul>
		</div>
		<div style="border-top: 1px solid #ccc; margin-top: 20px">
			<p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px;font-family: Arial, Helvetica, sans-serif;" class="mz-desktop-display">{{ labels.orderShippedDetails }}<p>
            <table class="mz-ordersummary" style="background: transparent; width: 100%;">
				<thead></thead>
			<tbody>
				
				{% for item in model.items %}	
				{% set_var isBrandAvailable=false %}
					{% with totalDiscount|add(item.itemDiscount) as overallDiscount %}
                        {% set_var totalDiscount=overallDiscount %}
					{% endwith %}
					<tr class="mz-ordersummary-line mz-ordersummary-line-item" style="border-bottom:0.1px solid #cccccc;">
						<td {% if themeSettings.isArabicLanguageSite%}style="padding: 20px 0 20px 16px; width:83px;font-family: Arial, Helvetica, sans-serif;"{% else %} style="padding: 20px 16px 20px 0; width:83px;font-family: Arial, Helvetica, sans-serif;"{% endif %}><img src="https:{{ item.imageUrl }}" width="83.87" height="108" /></td>
						<td {% if themeSettings.isArabicLanguageSite%}style="text-align:right; padding: 0 10px; vertical-align: baseline;"{% else %} style="text-align:left; padding: 0 10px; vertical-align: baseline;"{% endif %}>
							<p style="font-family: Arial, Helvetica, sans-serif;font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 20px 0 5px;">
								{% if item.data.properties %}
									{% for property in item.data.properties %}
										{% if property.values and not property.isHidden %}
											{%if property.name == 'Brand' %}
											{% set_var isBrandAvailable=true %}
												{% for v in property.values %}
													{% if v.stringValue %}{{v.stringValue}}{% else %}{{v.value}}{% endif %}
												{% endfor %}
											{% endif %}
										{% endif %}
									{% endfor %}
								{% endif %}
							</p>
							<p style="font-family: Arial, Helvetica, sans-serif;font-size: 14px; font-weight: bold; letter-spacing: 0; line-height: 18px; margin: 0;">{{ item.name }}</p>
							<p> 
								{% if item.options %}
									<dl class="mz-propertylist" style="display:flex !important;font-family: Arial, Helvetica, sans-serif;">
										{% for option in item.options %}
										<dd class="mz-propertylist-data" {% if themeSettings.isArabicLanguageSite%} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:0; margin-right:0; font-family: Arial, Helvetica, sans-serif;" {% else %} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:0; margin-right: 12px;font-family: Arial, Helvetica, sans-serif;"{% endif %}>
										{% if option.value %}
											{{ option.stringValue|default(value.value)}}
											{% if forloop.last == false %}, Size {% endif%}
										{% else %}
											{{ option.shopperEnteredValue }}
											{% if forloop.last == false %},{% endif%}
										{% endif %}
										</dd>
										{% endfor %}
									</dl>
								{% endif %}
								{% if item.quantity %}
								    <dl class="mz-propertylist-quantity">
									    <dd class="mz-propertylist-data" {% if themeSettings.isArabicLanguageSite%} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:12px; margin-right: 0; font-family: Arial, Helvetica, sans-serif;" {% else %} style="font-size: 14px; letter-spacing: 0; line-height: 18px; margin-left:0; margin-right: 12px;font-family: Arial, Helvetica, sans-serif;"{% endif %}>
									        {{labels.qty}}: {{item.quantity}}
									    </dd>
									</dl>
								{% endif %}
							</p>
							{% for reason in item.reasons %}
							<p style="font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">{{labels.qty}}: {{ reason.quantity }}</p>
							{% endfor %}
						</td>
						<td {% if themeSettings.isArabicLanguageSite%} style="vertical-align:top; text-align:left; {% if isBrandAvailable %} padding: 43px 15px 0 0; {% else %} padding: 20px 15px 0 0;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; width:84px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:right; vertical-align:top; {% if isBrandAvailable %} padding: 43px 0 0 15px; {% else %} padding: 20px 0 0 15px;{% endif %} font-size: 14px; letter-spacing: 0; line-height: 18px; width:84px; font-family: Arial, Helvetica, sans-serif;"{% endif %}> {{siteContext.currencyInfo.currencyCode}} {{item.lineItemCost|floatformat(2}}</td>
					</tr>	
				{% endfor %}
			</tbody>
				<tfoot style="width:100%;">
					<tr>
						<td {% if themeSettings.isArabicLanguageSite%} style="float:right; padding: 25px 0 0 0; width: 100px; font-size: 14px; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;"{% else %}  style="padding: 25px 0 0 0; width:100px; font-size: 14px; letter-spacing: 0; line-height: 18px; float:left !important; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{ labels.orderSummary }}</td> 
						<td></td>
					</tr> {% comment %}
						{% for item in model.items %}	
					<tr class="mz-ordersummary-subtotal">
						<td colspan="4" style="padding: 20px 0 10px 0">
						<span class="mz-ordersummary-totalname" style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{ labels.subtotal }}</span>
						<span class="mz-ordersummary-totalvalue" style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;">{{siteContext.currencyInfo.currencyCode}} {{item.lineItemCost|floatformat(pageContext.currencyInfo.precision)}}</span>
						</td>
					</tr>
				    	{% endfor %} {% endcomment %}
					<tr class="mz-ordersummary-subtotal">
						<td colspan="4" style="padding: 20px 0 10px 0">
						<span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{ labels.subtotal }}</span>
						<span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{siteContext.currencyInfo.currencyCode}} {{model.lineItemSubtotal|add(totalDiscount)|floatformat(pageContext.currencyInfo.precision)}}</span>
						</td>
					</tr>
					{% if  totalDiscount > 0  %}
						<tr class="mz-ordersummary-subtotal">
							<td colspan="4" style="padding: 0px 0 10px 0">
							<span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{ labels.totalDiscount }}</span>
							<span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;color:#000"{% endif %}>{{model.currencyCode}} {{totalDiscount|floatformat(pageContext.currencyInfo.precision)}}</span>
							</td>
						</tr>
                	{% endif %} 
					<tr class="mz-ordersummary-shippingtotal">
						<td colspan="4" style="padding: 0 0 10px 0">
						<span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{ labels.deliveryCost }}</span>
                        {% if  model.shippingTotal > 0  %}
						<span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{siteContext.currencyInfo.currencyCode}} {{ model.shippingTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
						{% else %}
                        <span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{labels.free}}</span>
                        {% endif %}  
                        </td>
					</tr>
					<tr class="mz-ordersummary-grandtotal">
						<td colspan="4" style="border-top: 1px solid #cccccc; border-bottom: 0.1px solid #cccccc; padding: 10px 0">
							<span class="mz-ordersummary-totalname" {% if themeSettings.isArabicLanguageSite%}style="text-align:right; float:right; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="text-align:left; float:left; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{ labels.total }}</span>
							<span class="mz-ordersummary-totalvalue" {% if themeSettings.isArabicLanguageSite%}style="float:left; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% else %} style="float:right; font-weight: 500; font-size: 14px; letter-spacing: 0; line-height: 28px; font-family: Arial, Helvetica, sans-serif;"{% endif %}>{{siteContext.currencyInfo.currencyCode}} {{model.total|floatformat(pageContext.currencyInfo.precision)}}</span>
						</td>
					</tr>
				</tfoot>
			</table>
		    <div>
				<div class="mz-paymentdetails">
			     	<p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.paymentDetails }}</p>
						<p style="font-size: 14px; letter-spacing: 0;   line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{model.destination.destinationContact.firstName }} {{ model.destination.destinationContact.lastNameOrSurname }}<br/>
							{{labels.paymentThrough}} 
								{% if model.order.payments %}
									{% for payment in model.order.payments %}
										{% if payment.billingInfo %}
											{% if payment.status != "Voided" and payment.status != "Declined" %}
												{% if payment.billingInfo.paymentType == 'CreditCard' and payment.billingInfo.card.paymentOrCardType != 'BLUEPREPAIDCARD' %} 	
												{% if webcounter == 0 %}
													{% set_var webcounter=1 %}
														{{labels.creditCard}}
													{% endif %}
												{% else %} {% if payment.billingInfo.paymentType|lower == 'check'%} {% set_var isCashOnDelivery=true %}{{labels.cashOnDelivery}} {% endif %} {% endif %}
												{% if payment.billingInfo.paymentType == 'token' and payment.billingInfo.token.type|lower == "bluewallet" %}  {{labels.blueWalletPayment}} {% endif %}
												{% if payment.billingInfo.card and payment.billingInfo.card.paymentOrCardType == 'BLUEPREPAIDCARD' and not isCashOnDelivery %}  {{labels.bluePrepaidPayment}} {% endif %}  
											{% endif %}
										{% endif %}
									{% endfor %}
								{% endif %}
						</p>
				</div>
				<div class="mz-deliverydetails">
					<p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.deliveryDetails }}</p>
					<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">
					    {% if  model.destination.destinationContact.address %}
					    {{  model.destination.destinationContact.address.address1}}<br/>
						{{  model.destination.destinationContact.address.address2}} {{  model.destination.destinationContact.address.address3}}<br/>
						{{ model.destination.destinationContact.address.cityOrTown}}<br/>
						{{ model.destination.destinationContact.address.countryCode}}
				    	{% endif %}
					</p>
				</div>	
				<div class="mz-contactdetails">
				    <p style="font-size: 12px; font-weight: bold; letter-spacing: 0; line-height: 16px; font-family: Arial, Helvetica, sans-serif;">{{ labels.contactDetails }}</p>
					<p style="font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000; font-family: Arial, Helvetica, sans-serif;">{{labels.contactFullName}}: {{model.destination.destinationContact.firstName }} {{ model.destination.destinationContact.lastNameOrSurname }}<br />
                    {{labels.mobile}}: {{model.destination.destinationContact.phoneNumbers.home}} </p>
				</div>
			</div>
		</div>
