{% extends "email/email" %}

{% block body-content %}
<div style="text-align:center;margin:30px 0;">
  <img src="https://cdn-tp1.euw1.kibocommerce.com/100067-m1/cms/files/cd619a01-49ed-49eb-9bf6-714a3688ee07" alt="MS-Logo" style="width: 103px;height: 39px;" width="103" height="39" loading="lazy">
</div>
<div class="emailPadding" style="font-family: Arial, Helvetica, sans-serif!important;">
{% if user and user.firstName %}
  <p style="margin-bottom:24px; font-size:14px; font-family: Arial, Helvetica, sans-serif!important;">
    {{ labels.newUserEmailSalutation }} {{ user.firstName }}
  </p>
{% else %}
  <p style="margin-bottom:24px; font-size:14px; font-family: Arial, Helvetica, sans-serif!important;">
    {{ labels.newUserEmailSalutationAlternative|safe}}
  </p>
{% endif %}

<p style="margin-bottom:24px;line-height:20px; font-size:14px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.newUserEmailNotification|safe }}</p>

<p style="margin-bottom:24px;line-height:20px; font-size:14px; font-family: Arial, Helvetica, sans-serif!important;">{{labels.newUserEmailOffer|safe }}</p>

<p style="margin-bottom:24px; font-size:14px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.code|safe }}: <strong>{{themeSettings.welcomePromotionCode}}</strong></p>

<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#163E35;color:#fff;letter-spacing:1px;">
<tr><td align="center" colspan="3" style="padding-bottom:20px;"><p style="margin:20px 0 0 0;font-size:16px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.whyShop|safe }}</p></td></tr>
<tr class="mz-whyShop-section">
  <td align="center" style="width:33.333%;vertical-align: top;padding: 0 2px;"  valign="middle">
    <p {% if themeSettings.isArabicLanguageSite%}style="transform: scalex(-1);margin:0px;"{% else %} style="margin:0px;"{% endif %}><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/Nextdaydelivery.png" alt="free Delivery" width="50" height="50" loading="lazy"/></p>
    <p style="margin-top: 10px;font-size:12px;font-weight:bold;text-transform:uppercase;margin-bottom:10px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.freeDeliveryEmail|safe }}</p>
    <p style="margin-top: 8px;font-size:10px; font-family: Arial, Helvetica, sans-serif!important;margin-left: 10px;">{% if themeSettings.nextDayDeliveryEmailDesc %} {{themeSettings.nextDayDeliveryEmailDesc}} {% else %} {{ labels.freeDeliveryEmailDesc}} {% endif %}</p>
  </td>
  <td align="center" style="width:33.333%;vertical-align: top;padding: 0 2px;"  valign="middle">
    <p {% if themeSettings.isArabicLanguageSite%}style="transform: scalex(-1);margin:0px;"{% else %} style="margin:0px;"{% endif %}><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/hasslefreereturn.png" alt="free Returns" width="50" height="50" loading="lazy"/></p>
    <p style="margin-top: 10px;font-size:12px;font-weight:bold;text-transform:uppercase;margin-bottom:10px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.hassleFreeDelivery|safe }}</p>
    <p style="margin-top: 8px;font-size:10px; font-family: Arial, Helvetica, sans-serif!important;margin-left: 10px;">{{ labels.hassleFreeReturnDesc}}</p>
  </td>
  <td align="center" style="width:33.333%;vertical-align: top;padding: 0 2px;"  {% if themeSettings.countrySpecificCode|lower == "om"%}valign="top"{% else %}valign="middle"{% endif %}>
    <p {% if themeSettings.isArabicLanguageSite%}style="transform: scalex(-1);margin:0px;"{% else %} style="margin:0px;"{% endif %}><img src="https://{{themeSettings.localeDomain}}/resources/images/icons/svg/Bluerewards.png" alt="secure Payment" width="50" height="50" loading="lazy"/></p>
    <p style="margin-top: 10px;font-size:12px;font-weight:bold;text-transform:uppercase;margin-bottom:10px; font-family: Arial, Helvetica, sans-serif!important;">{{ labels.blueRewards|safe }}</p>
    <p style="margin-top: 8px;font-size:10px; font-family: Arial, Helvetica, sans-serif!important;margin-right: 10px;">{{ labels.blueRewardsDesc|safe }}</p>
  </td>
</tr>
</table>



