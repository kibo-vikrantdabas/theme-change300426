			  <a style="padding:10px" href="https://www.youtube.com/user/MandSArabia" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="5"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/youtube.png"></a>
			  <a style="padding:10px" href="https://www.instagram.com/marksandspencerme" target="_blank" rel="noopener noreferrer" data-auth="NotApplicable" data-linkindex="6"><img data-imagetype="External" src="https://t100016-s100148.sb.euw1.kibocommerce.com/resources/images/icons/svg/instagram.png"></a>
			</p>
		  </div>

    <div style="text-align:center;font-size:10px; line-height:20px;width:100%; font-family: Arial, Helvetica, sans-serif;">
        <p style="color:#000">
			{{themeSettings.emailFooterAddress}}<br />{{themeSettings.emailFooterAddress1}}<br />{{themeSettings.emailFooterAddress2}}
		</p>
    </div>
</div>
{%else%}
	
	<div class="mz-email-template-product-instock" style="max-width:490px;font-family: Arial, Helvetica, sans-serif!important;">
        <div style="text-align:center;margin:30px 0;">
            <img src="https://cdn-tp1.euw1.kibocommerce.com/100067-m1/cms/files/cd619a01-49ed-49eb-9bf6-714a3688ee07" alt="MS-Logo" style="width: 103px;height: 39px;" width="103" height="39">
        </div>

		<table align="center" width="650" cellpadding="0" cellspacing="0" border="0" style="table-layout: fixed;background-color:#fff;">
			<tbody>
				<tr align="center" >
					<td colspan="2" style="text-align:center; height: 64px; width:490px; vertical-align:middle; background-color: #163E35; color: #ffffff; font-size: 21px; line-height: 24px;font-weight: 600;letter-spacing: 0;font-family: Arial, Helvetica, sans-serif;">
					{{labels.orderCancelledTitle}} 
					</td>
				</tr>
				<br>
				
				<tr align="left">
					<td style="padding-left:0px;padding-top: 20px; padding-bottom: 0;font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">
						<span style="font-weight:bold;font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">
							{{ labels.orderShipmentNumberEmail }}: </span> {{ model.orderNumber }} 
					</td>
				</tr>
				
				<tr align="left">
					<td style="padding-left:0px;padding-bottom: 0;padding-top:6px;font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">
						<span style="font-weight:bold;font-size: 14px; letter-spacing: 0; line-height: 18px; font-family: Arial, Helvetica, sans-serif;">
						{{ labels.orderDateEmail }}: </span> {% include "modules/common/date-time-format" with dateTimeFormatInput=model.submittedDate %} 
					</td>
				</tr>

				<tr align="left">
					<td style="padding-left:0px;padding-bottom: 0; padding-top: 20px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.emailOpeningHi }} {{ model.billingInfo.billingContact.firstName }},
					</td>
				</tr>				
				<tr align="left">
					{% if model.siteId == 100299 or model.siteId == 100300 or model.siteId == 100166 or model.siteId == 100167 %} 

						
					<td style="padding-left:0px;padding-top: 20px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.orderCancelledTextOnlineAE }}
					</td>
					<td style="padding-left:0px;padding-top: 20px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.orderCancelledTextOnline1AE }}
					</td>
					{% else %}
						<td style="padding-left:0px;padding-top: 20px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.orderCancelledTextOnline }}
					</td>
					<td style="padding-left:0px;padding-top: 20px;font-size: 14px;letter-spacing: 0;line-height: 21px;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.orderCancelledTextOnline1 }}
					</td>
					 {% endif %}
					
				</tr>

				{% if model.siteId == 100299 or model.siteId == 100300 %} 
				<tr align="left">
					<td style="padding-left:0px;padding-top: 5px;padding-bottom:5px;font-size:12px; letter-spacing: 0; line-height: 21px; color: #000;font-weight: bold;font-family: Arial, Helvetica, sans-serif;"> 
						{{ labels.returnCreatedWhatHappendNext1|safe }}
					</td>
				</tr>
				<tr align="left">
					<td style="padding-left:40px;padding-bottom:20px;padding-top: 0px;font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;font-family: Arial, Helvetica, sans-serif;"> 
						<ul style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;width:490px;font-family: Arial, Helvetica, sans-serif;'>
							<li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;'>
								{{ labels.orderCancelledNext1AE|safe }}
							</li>
							
							<li style='font-size: 14px; letter-spacing: 0; line-height: 21px; color: #000;'>
								{{ labels.orderCancelledNext2AE|safe }}
							</li>
						</ul>
					</td>
				</tr>
				{% endif %}

				{% if model.siteId == 100166 or model.siteId == 100167 %} 
