{% extends "page" %}

{% block title-tag-content %}{% firstof pageContext.metaTitle model.name %} - {% parent %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-needhelp mz-homepage {% endblock body-tag-classes %}

{% block body-content %}
{% require_script "pages/home" %}

<div class="main-wrapper">
    <div class="left-sidebar">
      {% include "modules/common/sidebar-nav"%}
    </div>
    <div class="right-sidebar">
        <div class="need-help-banner">
            {% dropzone "need-help-heading-banner" scope="template" %}
        </div>
        <div class="text-need-help">
            {% dropzone "text-help" scope="template" %}
        </div>
        <div class="help-section-content">
            {% dropzone "help-section-content" scope="template" %}
        </div>
        <div class="map-section-content">
            {% dropzone "map-section-content" scope="template" %}
        </div>
        <div class="other-section-content">
           {% include "modules/common/blue-loyalty-box"%}
           {% include "modules/common/loyalty-box"%}
        </div>
         <div class="latest-offer">
            {% dropzone "latest-offer" scope="template" %}
        </div>
        
    </div>
</div>





<div class="top-picks-wrapper-heading">
    {% dropzone "top-picks-wrapper-heading" scope="template" %}
</div>

<div class="top-picks-wrapper widget-spacer">
    {% dropzone "home-wrapper" scope="template" %}
</div>

{% dropzone "home2" scope="page" %}

{% dropzone "home3" scope="template" %}
<div class="autumn-container widget-spacer">
    {% dropzone "home4" scope="template" %}
</div>
    {% require_script "pages/need-help" %}
{% endblock body-content %}

{% block body-below-content %}
{% endblock body-below-content %}