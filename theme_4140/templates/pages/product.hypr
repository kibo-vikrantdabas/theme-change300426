{% extends "page" %}

{% block cacheheaders %}
{% if themeSettings.akamaiEdgeControlEnabledPDP %}
{% include "modules/cache-headers" %}
{% endif %}
{% endblock cacheheaders %}

{% block title-tag-content %} 
        {% firstof pageContext.metaTitle model.content.productName %}
{% endblock title-tag-content %}

{% block body-tag-classes %} mz-product {% endblock body-tag-classes %}

{% block body-content %}

{% require_script "pages/product" %}

{% preload_json model "product" %}

{% include "modules/seo/seo-product-schema" %}

    <div class="modal fade" id="confirmation-modal">
        {% include "modules/product/product-confirmation" %}
    </div>
{% comment %} <div itemscope itemtype="http://schema.org/Product" class="mz-l-container mz-product-container"> {% endcomment %}
<div class="mz-l-container mz-product-container  afg-ms-product-container">
    <div data-mz-productimages class="mz-productimages mz-l-sidebar afg-ms-productimages">
        {% include "modules/product/product-images" %}
    </div>
    <div class="mz-productdetail-wrap">
        <div id ="product-primary-detail">
            {% include "modules/product/product-primary-detail" %}
        </div>
        {% comment %} {% include "modules/common/message-bar" %} {% endcomment %}
        <div id="product-detail" class="mz-productdetail mz-l-stack">
            {% if model %}
                {% include "modules/product/product-detail" %}
            {% endif %}
            
        </div>
    </div>

</div>
<div class="product-slider-bottom">
    <div class="you-may-also-like">
        {% dropzone "you-may-also-like" scope="template" %}
    </div>
    <div class="style-it-with">
        {% dropzone "style-it-with" scope="template" %}
    </div>
    {% comment %} <div class="why-not-try">
        {% dropzone "why-not-try" scope="template" %}
    </div> {% endcomment %}
</div>

{% endblock body-content %}



 