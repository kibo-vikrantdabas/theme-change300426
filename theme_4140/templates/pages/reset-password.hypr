{% extends "page" %}

{% block title-tag-content %}{% firstof pageContext.metaTitle labels.resetPassword %}  - {% parent %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-reset-password-page {% endblock body-tag-classes %}

{% block body-content %}
{% require_script "pages/resetpassword" %}
{% if model.done %}
<div class="resetPasswordConfirmMessage">
    <input type="hidden" class="passwordDone" value="1">
    <span class="resetpasswordredirect" data-mz="{{siteContext.siteSubdirectory}}/home"></span>
    {% comment %} {% with labels.signIn as pageTitle%}
                    {% include "modules/signup/signup-header" with header=labels.resetPasswordMsg %}
                    {% endwith %}
                    {% with labels.returnTo as signUpQuery %}
                    {% with labels.signUpQueryLink as signUpQueryLink %}
                         {% with "/user/login" as signUpURL %}
                             {% include "modules/signup/signup-footer" %}
                          {%endwith%}
                    {%endwith%}
   {%endwith%}  {% endcomment %}
</div>
{% endif %}

{% if not model.done %}
    <div class="mz-l-container">
        <input type="hidden" class="passwordDone" value="0">
        <div class="mz-l-container mz-forgotpassword-main-container">
            <div class="mz-forgotpassword-form-main-container">
                <div class="mz-forgotpassword-form-container mz-reset-form-container">
                    {% with labels.passwordReset as pageTitle%}
                    {% include "modules/signup/signup-header" with header=labels.createPassword %}
                    {% endwith %}
                    {% if model.messages %}
                    {% for msg in model.messages%}
                    <div class="resetpassowrd-validation-error-msg">{{labels.invalidPassword}}</div>
                    <input type="hidden" value="{{msg.message}}" class="mz-model-msg">
                    {% endfor %}
                    {% endif %}
                    <div id="resetpasswordtoken">
                    {% include 'modules/forgotpassword/resetpasswordtoken' with model=model %}
                    </div>
                    <div id="resetpassword">
                        {% include 'modules/forgotpassword/resetpassword' with model=model %}
                    </div>
                </div>

            </div>
            <div class="mz-forgotpassword-sidebar-main-container">
            {% dropzone "signup-message-box" scope="template" %}
            </div>
        </div>
    </div>
{% endif %}
{% endblock body-content %}

{% block page-footer %} {% endblock page-footer %}
