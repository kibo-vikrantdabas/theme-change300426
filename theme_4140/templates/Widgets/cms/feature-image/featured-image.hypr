      for (
        var categoryNewShoesWrapperMiddleImagesIndex = 0;
        categoryNewShoesWrapperMiddleImagesIndex < categoryNewShoesWrapperMiddleImages.length;
        categoryNewShoesWrapperMiddleImagesIndex++
      ) {
        if (
          categoryNewShoesWrapperImages[
            categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
          ].hasAttribute("data-src")
        ) {
          var categoryNewShoesWrapperMiddleImagesUrl =
            categoryNewShoesWrapperImages[
              categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
            ].getAttribute("data-src");
            categoryNewShoesWrapperImages[
            categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
          ].alt = categoryNewShoesWrapperImages[
              categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
            ].getAttribute("data-alt");
          categoryNewShoesWrapperImages[
            categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
          ].srcset =
            categoryNewShoesWrapperMiddleImagesUrl +
            "?quality=75&maxWidth=80 80w," +
            categoryNewShoesWrapperMiddleImagesUrl +
            "?quality=75&maxWidth=100 100w," +
            categoryNewShoesWrapperMiddleImagesUrl +
            "?quality=75&maxWidth=150 150w," +
            categoryNewShoesWrapperMiddleImagesUrl +
            "?quality=75&maxWidth=191 191w";
          categoryNewShoesWrapperImages[
            categoryNewShoesWrapperMiddleImages[categoryNewShoesWrapperMiddleImagesIndex]
          ].sizes = "(max-width: 404px) 80px,(max-width: 501px) 120px,(max-width: 768px) 17vw,191px";
        }
      }
    }

    // offers-image-section
    var offersImageSection = document.querySelector(".offers-image-section");
    var offersImageSectionImages = (offersImageSection && offersImageSection.querySelectorAll("img")) || [];
    if (offersImageSectionImages.length > 0) {
      for (
        var offersImageSectionImage = 0;
        offersImageSectionImage < offersImageSectionImages.length;
        offersImageSectionImage++
      ) {
        if (offersImageSectionImages[offersImageSectionImage].hasAttribute("data-src")) {
          var offersImageSectionImageURL = offersImageSectionImages[offersImageSectionImage].getAttribute("data-src");
          offersImageSectionImages[offersImageSectionImage].alt = offersImageSectionImages[offersImageSectionImage].getAttribute("data-alt");
          offersImageSectionImages[offersImageSectionImage].srcset =
            offersImageSectionImageURL +
            "?quality=75&maxWidth=300 300w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=350 350w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=400 400w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=450 450w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=500 500w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=550 550w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=600 600w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=650 650w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=700 700w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=750 750w," +
            offersImageSectionImageURL +
            "?quality=75&maxWidth=800 800w";
          offersImageSectionImages[offersImageSectionImage].sizes =
            "(max-width: 767px) 90vw,(max-width: 1280px) 50vw,630px";
        }
      }
    }

    // explore-image
    var exploreImageContainer = document.querySelector(".explore-image .feature-image-content");
    var exploreImages = (exploreImageContainer && exploreImageContainer.querySelectorAll("img")) || [];
    if (exploreImages.length > 0) {
      for (var exploreImage = 0; exploreImage < exploreImages.length; exploreImage++) {
        if (exploreImages[exploreImage].hasAttribute("data-src")) {
          var exploreImageURL = exploreImages[exploreImage].getAttribute("data-src");
          exploreImages[exploreImage].alt = exploreImages[exploreImage].getAttribute("data-alt");
          exploreImages[exploreImage].srcset =
            exploreImageURL +
            "?quality=75&maxWidth=250 250w," +
            exploreImageURL +
            "?quality=75&maxWidth=300 300w," +
            exploreImageURL +
            "?quality=75&maxWidth=350 350w," +
            exploreImageURL +
            "?quality=75&maxWidth=400 400w," +
            exploreImageURL +
            "?quality=75&maxWidth=450 450w," +
            exploreImageURL +
            "?quality=75&maxWidth=500 500w," +
            exploreImageURL +
            "?quality=75&maxWidth=550 550w," +
            exploreImageURL +
            "?quality=75&maxWidth=600 600w," +
            exploreImageURL +
            "?quality=75&maxWidth=650 650w," +
            exploreImageURL +
            "?quality=75&maxWidth=700 700w," +
            exploreImageURL +
            "?quality=75&maxWidth=778 778w";

          exploreImages[exploreImage].sizes =
            "(max-width: 501px) 78vw,(max-width: 801px) 49vw,(max-width: 1286px) 58vw,778px";
        }
      }
    }

    // top-picks-wrapper-heading
    var topPicksWrapperHeading = document.querySelector(".top-picks-wrapper-heading");
    var topPicksWrapperHeadingImages = (topPicksWrapperHeading && topPicksWrapperHeading.querySelectorAll("img")) || [];
    if (topPicksWrapperHeadingImages.length > 0) {
      for (var topPicksWrapperHeadingImage = 0; topPicksWrapperHeadingImage < topPicksWrapperHeadingImages.length; topPicksWrapperHeadingImage++) {
        if (topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].hasAttribute("data-src")) {
          var topPicksWrapperHeadingImageURL = topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].getAttribute("data-src");
          topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].alt = topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].getAttribute("data-alt");
          topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].srcset =
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=300 300w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=350 350w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=400 400w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=450 450w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=500 500w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=550 550w," +
            topPicksWrapperHeadingImageURL +
            "?quality=75&maxWidth=570 570w";

          topPicksWrapperHeadingImages[topPicksWrapperHeadingImage].sizes =
            "(max-width: 766px) 90vw, (max-width: 767px) 85vw,(max-width: 1140px) 48vw, 570px";
        }
      }
    }

    //default image
    var defaultImages = document.querySelectorAll(".feature-image-content") || [];
    for (var defaultImage = 0; defaultImage < defaultImages.length; defaultImage++) {
      if (!defaultImages[defaultImage].hasAttribute("srcset") && defaultImages[defaultImage].hasAttribute("data-src")) {
        defaultImages[defaultImage].alt = defaultImages[defaultImage].getAttribute("data-alt")
        defaultImages[defaultImage].srcset = defaultImages[defaultImage].getAttribute("data-src") + "?quality=75";
      }
    }
  });
</script>