<div class="featured-image-container">
    {% with Model.config.img as img %}
        {% with Model.config.link as link %}
            {% with Model.config.linkUrl as linkUrl %}
            {% with Model.config.linkSecondary as linkSecondary %}
            {% with Model.config.linkUrlSecondary as linkUrlSecondary %}
                {% with Model.config.alignment as alignment %}
                    {% with Model.config.columnAlignment as columnAlignment %}
                        {% with Model.config.displayTextLinksCenter as displayTextLinksCenter %}
                            {% with Model.config.title as title %}
                                {% with Model.config.displayTitle as displayTitle %}
                                     {% with Model.config.sectionName as sectionName %}
                            {% include "widgets/cms/feature-image/featured-image-content" %}
                                    {% endwith %}
                            {% endwith %}
                    {% endwith %}
                        {% endwith %}
                    {% endwith %}
                {% endwith %}

            {% endwith %}
            {% endwith %}   
            {% endwith %}
        {% endwith %}
    {% endwith %}
</div>
<script>
