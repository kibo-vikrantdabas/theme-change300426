<div class="mz-l-container">
         
    <div class="mz-l-container mz-forgotpassword-main-container">
        <div class="mz-forgotpassword-form-main-container">
            <div class="mz-forgotpassword-form-container">
                {% with labels.signIn as pageTitle%} 
                {% include "modules/signup/signup-header" with header=labels.forgotPasswordText %}
                {% endwith %}
                <div id="forgotpassword">
                    {% include 'modules/forgotpassword/forgotpasswordform'%}
                </div>
                {% with labels.returnTo as signUpQuery %}
                {% with labels.signUpQueryLink as signUpQueryLink %}
                     {% with "/user/login" as signUpURL %}
                         {% include "modules/signup/signup-footer" %}
                      {%endwith%}
                {%endwith%}
             {%endwith%}
            </div>
       
        </div>
       <div class="mz-forgotpassword-sidebar-main-container">
           {% include "modules/signup/signup-sidebar" %}
       </div>
       
        
    </div>
</div>