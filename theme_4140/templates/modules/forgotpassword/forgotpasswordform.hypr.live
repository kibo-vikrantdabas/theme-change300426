<form method="post" class="mz-loginform mz-loginform-page mz-forgot-password-form" name="mz-forgotpasswordform">

    <input type="hidden" name="returnUrl" value="{{ model.returnUrl }}" />
    <div class="mz-login-form-field">
        <div class="email-div">
            
            <div class="mz-l-formfieldgroup-cell">
                <input type="email" class="text-input forgotpassword-email" data-mz-forgotpassword-email name="reset-password" placeholder="{{ labels.forgotPasswordPlacehodler }}" />
            </div>
        </div>
        <div class="mz-forgot-error-msg hidden"></div>
        <div class="forgotpasswordbutton-div">
            <div class="mz-l-formfieldgroup-cell"></div>
            <div class="mz-l-formfieldgroup-cell">
                <button type="submit" class="mz-forgotpassword-page-button forgotpassword-submit" data-mz-action="forgot-submit" onclick="">{{ labels.sentPasswordResetLink }}</button> 
                <div class="mz-l-formfieldgroup-cell">
                    <section data-mz-role="popover-message" class="mz-popover-message"></section>
                </div>
            </div>
        </div>
    </div>
</form>