<div class="mz-l-container">
    <div class="mz-l-container mz-forgotpassword-main-container">
        <div class="mz-forgotpassword-form-main-container">
            <div class="mz-forgotpassword-form-container mz-forgotpassword-msg-container">
                {% with labels.signIn as pageTitle%} 
                {% include "modules/signup/signup-header" with header=labels.forgotPasswordSendText %}
                {% endwith %}
                <div class="mz-forgotpasswordtext">
                    {{labels.forgotPasswordConfirmText|safe}}
                </div>
                {% with labels.forgotpasswordfooterText as signUpQuery %}
                {% with labels.forgotpasswordFooterlink as signUpQueryLink %}
                     {% with "/user/forgotpassword" as signUpURL %}
                         {% include "modules/signup/signup-footer" %}
                      {%endwith%}
                {%endwith%}
             {%endwith%}
            </div>
       
        </div>
       <div class="mz-forgotpassword-sidebar-main-container">
         {% include "modules/signup/signup-sidebar" %}
       </div>
       
        
    </div>
</div>