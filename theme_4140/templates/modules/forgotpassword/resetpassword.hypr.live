<form method="post" class="mz-loginform mz-loginform-page mz-reset-password-form">
    
    <div class="resetPasswordFormGroup">
         <div class="password-div form-div">
             <div class="mz-password-input"> 
                 <input name="password" class="text-input password" type="password" data-mz-reset-password/>
                 <a id="eye-password-register1" class="eye">  
                      <span class="eye-open eye-text"><img class="eye-image" alt="eyeopen" src="{{siteContext.cdnPrefix}}/resources/images/icons/Eye.svg"> {{ labels.show }}</span>
                      <span class="eye-close eye-text hidden"><img class="eye-image" alt="eyehidden" src="{{siteContext.cdnPrefix}}/resources/images/icons/EyeHidden.svg"> {{ labels.hide }}</span>
                  </a> 
             </div>
         </div>
         <div class="password-strength-meter">
             <div class="password-strength-indication"><div class="password_s1 strength"></div><div class="password_s2 strength"></div><div class="password_s3 strength"></div></div>
             <div class="password-validation-msg"></div>
         </div>
         <div class="confirmpassword-div">
             <div class="mz-confirm-password-input">
                 <input name="passwordconfirm" class="text-input password confirmpassword"  type="password" data-mz-reset-confirmpassword/>
                 <a id="eye-password-register" class="eye">    
                    <span class="eye-open eye-text"><img class="eye-image" alt="eyeopen" src="{{siteContext.cdnPrefix}}/resources/images/icons/Eye.svg"> {{ labels.show }}</span>
                    <span class="eye-close eye-text hidden"><img class="eye-image" alt="eyehidden" src="{{siteContext.cdnPrefix}}/resources/images/icons/EyeHidden.svg"> {{ labels.hide }}</span>
                 </a> 
             </div>
         </div>
         <div class="password-strength-meter">
            <div class="confirm-password-validation-msg"></div>
        </div>
         <div class="forgotpasswordbutton-div">
             <div class="mz-l-formfieldgroup-cell"></div>
             <div class="mz-forget-password-input">
                 <button class="mz-forgotpassword-page-button resetpassword-submit" disabled="disabled">{{ labels.resetPasswordButtion }}</button>
             </div>
         </div>
     </div>
 </form>