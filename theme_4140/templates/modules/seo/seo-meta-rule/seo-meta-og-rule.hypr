<meta property="og:type" content="{{ pageContext.pageType }}" />
{% if pageContext.cmsContext.template.path == 'parent-category'  or pageContext.cmsContext.template.path == 'category' %}
        <meta property="og:title" content="{{ model.content.metaTagTitle }}" />
        <meta property="og:description" content="{{ model.content.metaTagDescription }}" />
{% else %}
<meta property="og:title" content="{{ pageContext.metaTitle }}" />
<meta property="og:description" content="{{ pageContext.metaDescription }}" />
{% endif %}
<meta property="og:url" content="{{ pageContext.url }}" />
<meta property="og:locale" content="{{themeSettings.siteLanguage}}" />
<meta property="og:site_name" content="{{ siteContext.generalSettings.websiteName }}" />