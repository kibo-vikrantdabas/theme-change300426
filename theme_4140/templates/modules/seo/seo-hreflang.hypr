
{% if pageContext.crawlerInfo.canonicalUrl and pageContext.cmsContext.page.path == 'home'  %}

      <link rel="alternate" hreflang="x-default" href="{{pageContext.secureHost}}/{{themeSettings.enSiteLocale}}" />
    
      <link rel="alternate" hreflang="{{themeSettings.enSiteLocale}}" href="{{pageContext.secureHost}}/{{themeSettings.enSiteLocale}}"/>
    
      <link rel="alternate" hreflang="{{themeSettings.arSiteLocale}}" href="{{pageContext.secureHost}}/{{themeSettings.arSiteLocale}}"/>
    
      <link rel="canonical" href="{{PageContext.secureHost}}{{siteContext.siteSubdirectory}}">
    {{themeSettings.homePage|safe}}
{% else %}
{% if pageContext.crawlerInfo.canonicalUrl %}
      {% with pageContext.crawlerInfo.canonicalUrl|split("?")|first as canonicalUrl%}
        <link rel="alternate" hreflang="x-default" href="{{PageContext.secureHost}}{% if not themeSettings.isArabicLanguageSite %}{{canonicalUrl}}{% else %}{{canonicalUrl|replace(themeSettings.arSiteLocale, themeSettings.enSiteLocale)}}{% endif %}"/>
        
            <link rel="alternate" hreflang="{{themeSettings.enSiteLocale}}" href="{{PageContext.secureHost}}{% if not themeSettings.isArabicLanguageSite %}{{canonicalUrl}}{% else %}{{canonicalUrl|replace(themeSettings.arSiteLocale, themeSettings.enSiteLocale)}}{% endif %}"/>
        
            <link rel="alternate" hreflang="{{themeSettings.arSiteLocale}}" href="{{PageContext.secureHost}}{% if themeSettings.isArabicLanguageSite %}{{canonicalUrl}}{% else %}{{canonicalUrl|replace(themeSettings.enSiteLocale, themeSettings.arSiteLocale)}}{% endif %}"/>
       
        <link rel="canonical" href="{{PageContext.secureHost}}{{ canonicalUrl }}" />
      {% endwith %}
  {% else %}
    {# LAST ELSE — your requirement, but guarded #}
    {% if pageContext and pageContext.url %}
      <link rel="canonical" href="{{ pageContext.url }}" />
    {% else %}
      {% if pageContext and pageContext.requestPath %}
        {% with pageContext.requestPath|split("?")|first|split("#")|first as canonicalUrl %}
          <link rel="canonical" href="{{ pageContext.secureHost }}{{ canonicalUrl }}" />
        {% endwith %}
      {% else %}
          <link rel="canonical" href="{{ pageContext.secureHost }}/" />
      {% endif %}
    {% endif %}
  {% endif %}

{% endif %}
