        "@type": "Question",
        "name": "How can I add an address to my account?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sign in to your account.Click on ‘My account’ at the top of your page and navigate to ‘Go to my account’.Click on Delivery Address’ under ‘Payment And Delivery’ on the ‘My Account’ page.Click on add new address. Or You can add your address in chekcout page."
        }
      },
      {
        "@type": "Question",
        "name": "How can I change my email address?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sign in to your account.Click on ‘My account’ at the top of your page and navigate to ‘Go to my account’.Click on Personal Details’ under ‘Profile’ on the ‘My Account’ page.Click on edit email address."
        }
      },
      {
        "@type": "Question",
        "name": "How can I change my name?",
        "acceptedAnswer": {
          "@type": "Answer",
