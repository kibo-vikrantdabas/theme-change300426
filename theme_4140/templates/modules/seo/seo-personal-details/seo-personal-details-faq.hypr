        }
      },
      {
        "@type": "Question",
        "name": "Are my credit or debit card details saved in my account?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We don’t automatically save your card details. If you would like us to save them for your next order, click the ‘Save this card’ option after you’ve entered your card details for payment. Alternatively, add a card on the ‘View and add payment details’ section of the ‘My Account’ page."
        }
      },
      {
        "@type": "Question",
        "name": "Is my personal data safe if I create an account?",
