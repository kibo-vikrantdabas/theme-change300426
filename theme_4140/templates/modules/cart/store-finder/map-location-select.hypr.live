<div class="location-select-dropdown-container" data-mz-action="toggleDropdown" data-mz-displayDrop="{{location.code}}" data-mz-storeName="{{location.name}}">
		<div class="location-select-container {% if model.activeDropdown == location.code %} active {% endif %}" style="display:flex"  id="{{location.name}}"data-mz-cart-item= "">
			<div class="location-dropdown-container {% if model.activeDropdown == location.code %} active {% endif %}" style="flex:1">
				<img class="location-select-logo" src= "{{siteContext.cdnPrefix}}/resources/images/MS-Logo.png"/>
				<h4 style="">{{location.name}}</h4>
				{% if model.selectedLocation == location.name  %}
					<div class="selected-store-display {% if model.selectedLocation == location.name %}active {% endif %}">
						<img class="store-confirmation-tick"src="{{siteContext.cdnPrefix}}{{labels.svgIconPath}}Tick-Green.svg"/>
						<span class="selected-store-message"> {{labels.selectedstore}}</span>
					</div>
				{% else %}
					<div></div>
				{% endif %}
				<div class="location-distance-display">{{location.approxDistance}} {{labels.km}}</div>
			</div>
		</div>
		<div class="dropdown-info-container">
			<div class='column-fill'>
				<img class="location-select-logo" src= "{{siteContext.cdnPrefix}}/resources/images/MS-Logo.png" style="visibility: hidden"/>
			</div>
				<div class="dropdown-info">
					<div class="location-address-line">
						<span>{{location.address.address1}} {{location.address.address2}} {{location.address.cityOrTown}}</span>
					</div>
					<div class="opening-hours-display" data-mz-action="toggleHoursDropdown" data-mz-isHrsActive="false">
						<div class="dropdown-select-container {% if model.isHrsActive %} active {% endif%}">
							<div class="store-opening-times">{{labels.storeOpeningTimes}}</div> 
						</div>
						<div class="hours-dropdown-container {% if model.isHrsActive%} active {% endif%}" >
							{% with location.regularHours as regHrs %}
							<ul class="hours-dropdown">
								<li class="hours-dropdown-day">{{labels.monday}}: {{regHrs.monday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.tuesday}}: {{regHrs.tuesday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.wednesday}}: {{regHrs.wednesday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.thursday}}: {{regHrs.thursday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.friday}}: {{regHrs.friday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.saturday}}: {{regHrs.saturday.modHours|lower}}</li>
								<li class="hours-dropdown-day">{{labels.sunday}}: {{regHrs.sunday.modHours|lower}}</li>
							<ul>
							{% endwith %}
						</div>
					</div> 
					
					<div class="select-store-btn-display">
						<button type="button" class="cnc-select-button mz-store-select-button" aria-hidden: "true", data-mz-location-data='{ "code":{{location.code}}, "name":"{{location.name}}"}' data-mz-action="selectStoreForPickup">{{labels.selectStoreFree}}</button>
					</div>
				</div>
			<div class='column-fill'></div>
		</div>
	</div>