<nav class="mz-sitenav afg-ms-sitenav desktop hide-on-mobile">
    <ul class="mz-sitenav-list" 
        data-mz-contextify='.mz-sitenav-link[href="{{ navigation.currentNode.url }}"]'
        data-mz-contextify-attr='class'
        data-mz-contextify-val='is-current'>
        {% partial_cache %}
        {% with navigation.tree as navNode %}
                {% include "modules/global-nav/desktop/global-nav-parent" with navNodes=navNode %}
                {% comment %} {% include "modules/global-nav/desktop/global-nav-more" with navNodes=navNode desktop=true %} {% endcomment %}
        {% endwith %}
        {% endpartial_cache %}
        {% require_script "modules/contextify" %}
    </ul>
</nav>

{% if pageContext.isTablet or pageContext.isMobile %}
    <div class="mz-backdrop deactive"></div>
{% endif %}
