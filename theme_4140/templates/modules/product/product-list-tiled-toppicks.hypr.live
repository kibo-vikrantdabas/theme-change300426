{% comment %} {% extends "modules/product/product-list" %}
{% block module-classes %}mz-productlist-tiled{% endblock module-classes %}
{% block list-classes %}mz-l-tiles{% endblock list-classes %} {% endcomment %}

<div class="mz-productlist {% block module-classes %}{% endblock module-classes %}">
    {% if model.items %}
    <div class="mz-productlist-list-toppick four-column {% block list-classes %}{% endblock list-classes %}">
        {% for prod in model.items %}
            <div class="mz-productlist-item" data-mz-product="{{ prod.productCode }}">{% include "modules/product/product-listing" with model=prod %}</div>
        {% endfor %}
    </div>
    {% endif %}
</div>