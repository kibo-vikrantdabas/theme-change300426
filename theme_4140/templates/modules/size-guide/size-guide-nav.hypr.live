				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-nightwear"%}"><li>{{labels.nightwear}}</li></a>
				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-petite"%}"><li>{{labels.petite}}</li></a>
				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-plus"%}"><li>{{labels.plus}}</li></a>
				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-skirts"%}"><li>{{labels.skirts}}</li></a>
