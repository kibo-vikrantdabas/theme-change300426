					<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="mens-night-sets"%}"><li>{{labels.nightSets}}</li></a>
					<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="mens-outerwear"%}"><li>{{labels.outerwear}}</li></a>
