<div class="mz-size-guide-dropdown-display">
	<ul class="size-guide-dropdown-list">
		<li class="size-guide-main-cat-item">
			<input type="checkbox" class="size-guide-main-cat" id="women" style="display:none">
			<div class="size-guide-main-name">
				<label for="women">
					<h4>{{labels.women}}</h4>
				</label>
			</div>
			<ul class="size-guide-subcategory">
				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-dresses"%}"><li>{{labels.dresses}}</li></a>
				<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="womens-footwear"%}"><li>{{labels.footwear}}</li></a>
