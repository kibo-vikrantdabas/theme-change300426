					<label for="men">
						<h4>{{labels.men}}</h4>
					</label>
				</div>
				<ul class="size-guide-subcategory">
					<a href="{{siteContext.siteSubdirectory}}{% make_url "document" name="mens-casual-shirt"%}"><li>{{labels.casualShirt}}</li></a>
