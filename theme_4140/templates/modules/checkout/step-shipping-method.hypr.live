    <h3 class="mz-formstep-header mz-checkoutform-header">
       2. {{ labels.shippingMethod }}
    </h3>
    <div class="mz-formstep-body mz-checkoutform">
        <div class="selected-shipmethod-div select-div {% if model.isEditShippingMethod %} hidden {% endif %}">
            <div class="display-shipmentmethod-div">
                {% for method in model.availableShippingMethods %}
                {% if model.shippingMethodCode == method.shippingMethodCode %}
                <img src="{{siteContext.cdnPrefix}}{{labels.svgIconPath}}delivery-1.svg" alt="location-icon" class="mz-locationIcon">
                 <div class="display-shipmentname hidden">{{method.shippingMethodName}}</div>
                 <div class="delivery-days-div">
                    <span class="type-of-delivery">{{ labels.standardDelivery }}</span>
                    <span class="deliverydays">By {{model.shippedDate}}</span>
                </div>
                 <div class="mz-changeShipmentMethodButton">
    
                    <a href="javascript:;" class="shipment-change-button" data-mz-action="editShippingMethod">{{labels.change}}</a>
                 </div>
                 {% endif %}
                 {% endfor %}
            </div>
            
        </div>
        
        <div class=" new-shipment-method-div  {% if not model.isEditShippingMethod %} hidden {% endif %}">
            {% if model.requiresFulfillmentInfo %}
            {% if model.availableShippingMethods.length %}
                {% for method in model.availableShippingMethods %}
                {% comment %} {% if model.shippingMethodCode%}

                   {%else%} {% endcomment %}
                    <div class="selected-shipmethod-div-new">
                        {% comment %} <label>
                            <input type="radio" name="shippingMethod"
                                   value="{{ method.shippingMethodCode }}" data-mz-value="shippingMethodCode" data-mz-shipping-method
                                   >
                            {{ method.shippingMethodName }} {{ method.price|currency }}
                        </label> {% endcomment %}
                        <div class="checkout-method-div">
                        <label class="container-radio">
                            <input type="radio" name="shippingMethod"
                            value="{{ method.shippingMethodCode }}" data-mz-value="shippingMethodCode" data-mz-shipping-method {% if model.shippingMethodCode == method.shippingMethodCode %} checked {% endif %} />
                            <span class="checkmark-radio"></span>
                        </label>
                        <div class="display-shipmentname-selected">{{ method.shippingMethodName|upper }}</div>
                        <div class="delivery-days-div">
                            <span class="type-of-delivery">{{ labels.standardDelivery }}</span>
                            <span class="deliverydays">By {{model.shippedDate}}</span>
                        </div>
                    </div>
                    </div>
                    {% comment %} {%endif%} {% endcomment %}
                {% endfor %}
                <div class="mz-formstep-next">
                    <button type="button" class="mz-confirm-delivery-btn" data-mz-action="next">{{ labels.confirmDeliveryOption }}</button>
                </div>
                <span class="mz-validationmessage" data-mz-validationmessage-for="shippingMethodCode"></span>
            {% else %}
                <p>{{ labels.noShippingMethods }}</p>
            {% endif %}
        {% else %}
            {{ labels.noFulfillmentInfoRequired }}
        {% endif %}
        
        </div>
      
    </div>