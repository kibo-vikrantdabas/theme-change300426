<table class="mz-ordersummary-checkout-v2 custom">
    <thead class="mz-ordersummary-checkout-header">
        <tr class="mz-ordersummary-checkout-headerrow {% if themeSettings.isSplitShipmentApply %} mz-handlePosition{% endif %}"> 
            <th class="mz-ordersummary-checkout-itemcount">
                <img src="{{siteContext.cdnPrefix}}{{labels.svgIconPath}}Bag.svg" width="26" height="26" alt="bag-checkout-icon" class="mz-bag-checkout-icon">
                <span class="mz-ordersummary-checkout-itemmodal"> 
                  <span id="itemQtyCountOS"></span> {{labels.items}}
                </span>
            </th> 
            <th class="mz-ordersummary-checkout-itemtotalprice">{{model.currencyCode}} {{ model.total|floatformat(2)}}<img src="{{siteContext.cdnPrefix}}/resources/images/icons/arrow-down.png" width="15" height="15" alt="down-checkout-icon" class="mz-down-checkout-icon"></th>
        </tr>
    </thead>
    <tbody class="mz-ordersummary-lineitems {% if model.items.length < 2 %}mz-without-item-scroll {% endif %}">
    {% for item in model.items %}        
          <tr class="mz-ordersummary-line mz-ordersummary-line-item {% if item.discountTotal > 0 %}is-discounted{% endif %}">
                <td class="mz-ordersummary-item-product-img">
                    <div class="mz-ordersummary-item-image">
                      {%if item.product.imageUrl %}
                        <img src="{{ item.product.imageUrl }}" width="73" height="94" alt="item-image" />
                      {% else %}
                        <span class="mz-noImg">{{labels.productImagePlaceholder}}</span>
                      {% endif %}
                    </div>
                </td>
                <td class="mz-ordersummary-item-product-details">
                    {% if item.product.properties %}
                    <span class="mz-ordersummary-item-brand">
                        {% for property in item.product.properties %}
                            {% if property.values and not property.isHidden %}
                                {%if property.name == 'Brand' %}
                                    {% for v in property.values %}
                                        {% if v.stringValue %}{{v.stringValue}}{% else %}{{v.value}}{% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </span>
                    {% endif %}
                    <h4 class="mz-ordersummary-item-brand-productname"> {{ item.product.name }} </h4>
                    {% if item.product.options %}
                    <dl class="mz-propertylist">
                        {% for option in item.product.options %}
                          <dd class="mz-propertylist-data">
                          {% if option.value %}
                            {% comment %} {{ option.value }} {% endcomment %}
                            {{ option.stringValue|default(value.value)}}
                          {% else %}
                            {{ option.shopperEnteredValue }}
                          {% endif %}
                          </dd>
                        {% endfor %}
                    </dl>
                    {% endif %}              
                    <div class="mz-ordersummary-item-qty-price">
                        <span class="mz-ordersummary-item-qty" data-quantity="{{ item.quantity }}">{{labels.qty}}: {{ item.quantity }}</span>
                        <span class="mz-ordersummary-item-price">
                          {% comment %} {% include "modules/common/item-total" %} {% endcomment %}
                          <span class="mz-item-rowtotal {% if item.unitPrice.saleAmount %}is-saleprice{% endif %}"><span class="currency-code"> {{model.currencyCode}} </span>{{ item.total|floatformat(pageContext.currencyInfo.precision) }}</span>
                        </span>
                    </div>
                </td>
                {% comment %}
                <td>{% include "modules/common/item-price" %}</td>
                {% endcomment %}
            </tr>       
    {% endfor %}
    </tbody>
  
    <tbody class="mz-ordersummary-calc">
        <tr class="mz-ordersummary-subtotal">
          <td colspan="4" class="mz-ordersummary-subtotal-value">
            <span class="mz-ordersummary-totalname">{{ labels.subtotalCheckout }}</span>
            <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.subtotal|floatformat(pageContext.currencyInfo.precision) }}</span>
          </td>
        </tr>
        {% if model.blueWallet %}
          <tr class="mz-orderSummaryBlueWallet">
            <td colspan="4" class="mz-blueWalletAmount">
              <span class="mz-blueWalletLabel">{{labels.blueWalletPayment}}</span>
              <span class="mz-blueWalletValue"> - {{model.currencyCode}} {{model.blueWallet|floatformat(pageContext.currencyInfo.precision)}}</span>
            </td>
          </tr>
        {% endif %}
        {% if model.bluePrepaidCard %}
          <tr class="mz-orderSummaryBlueCard">
            <td colspan="4" class="mz-blueCardAmount">
              <span class="mz-blueCardLabel">{{labels.blueCreditPayment}}</span>
              <span class="mz-blueCardValue"> - {{model.currencyCode}} {{model.bluePrepaidCard|floatformat(pageContext.currencyInfo.precision)}}</span>
            </td>
          </tr>
        {% endif %}
        {% if model.discountTotal > 0 %}
        <tr class="mz-ordersummary-totalsaving" id="mz-total-saving-checkout">
          <td colspan="4" class="mz-ordersummary-total-saving">
            <span class="mz-ordersummary-totalsavingname">
              <img src="{{siteContext.cdnPrefix}}/resources/images/icons/arrow-down.png" alt="down-cart-icon" class="mz-down-cart-icon">
              <span class="total-saving-text" {% if model.orderDiscounts %}id="mz-total-saving" {% endif %}>{{labels.totalSaving}}</span>
            </span>
            <span class="mz-ordersummary-totalsavingamt">- {{model.currencyCode}} {{ model.discountTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
          </td>
        </tr>
        <tr class="mz-ordersummary-totalsaving-value mz-ordersummary-discount" id="mz-total-saving-value-checkout" style="display: none;">
          {% for item in model.items %}
            {% for productDiscount in item.productDiscounts %}
              {% if productDiscount %}
                  <td colspan="4" class="mz-ordersummary-discount-value">
                    <span class="mz-ordersummary-discountname">{% comment %}{{ productDiscount.discount.name }}{% endcomment %}{{labels.promotionCode}}</span>
                    {% if productDiscount.discount.freeShipping %}
                    <span class="mz-ordersummary-discountamt">{{ labels.freeShipping }}</span>
                    {% else %}
                    <span class="mz-ordersummary-discountamt">- {{model.currencyCode}} {{ productDiscount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
                    {% endif %}
                  </td>
              {% endif %}
            {% endfor %}
          {% endfor%}
          {% for discount in model.orderDiscounts %}
            {% if not discount.excluded %}
              <td colspan="4" class="mz-ordersummary-discount-value">
                <span class="mz-ordersummary-discountname">{% comment %}{{ discount.discount.name }}{% endcomment %}{{labels.promotionCode}}</span>
                <span class="mz-ordersummary-discountamt">- {{model.currencyCode}} {{ discount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
              </td>
            {% endif %}
          {% endfor %}
          {% for shippingDiscount in model.shippingDiscounts %}
              <td colspan="4" class="mz-ordersummary-discount-value">
                <span class="mz-ordersummary-discountname">{{ shippingDiscount.discount.discount.name }}</span>
                <span class="mz-ordersummary-discountamt">- {{model.currencyCode}} {{ shippingDiscount.discount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
              </td>
          {% endfor %}
        </tr>
        {% endif %}
        {% if model.dutyTotal > 0 %}
          <tr class="mz-ordersummary-tax"> 
            <td colspan="4" class="mz-ordersummary-tax-value">
              <span class="mz-ordersummary-totalname">{{ labels.taxDuty }}</span>
              <span class="mz-ordersummary-totalvalue">{% filter currency %} {{ model.dutyTotal|add(model.taxTotal)}} {% endfilter %}</span>
            </td>
          </tr>
        {% else %}
          {% if model.taxTotal > 0 %}
          <tr class="mz-ordersummary-tax">
              <td colspan="4" class="mz-ordersummary-tax-value">
                  <span class="mz-ordersummary-totalname">{{ labels.tax }}</span>
                  <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.taxTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
              </td>
          </tr>
          {% endif %}
        {% endif %}
        <tr class="mz-ordersummary-shippingtotal">
          <td colspan="4" class="mz-ordersummary-shippingtotal-value">
            <span class="mz-ordersummary-totalname">{{ labels.delivery }}</span>
            <span class="mz-ordersummary-totalvalue">
              {% if model.shippingSubTotal == 0 %}
                {{ labels.free }}
              {% else %}
                {{model.currencyCode}} {{ model.shippingSubTotal|floatformat(pageContext.currencyInfo.precision) }}
              {% endif %}
            </span>
          </td>
        </tr>
        {% if model.handlingTotal > 0 %}
        <tr class="mz-ordersummary-additionalhandling">
            <td colspan="4" class="mz-ordersummary-additionalhandling-value">
              <span class="mz-ordersummary-totalname">{{ labels.additionalHandling }}{% if model.handlingAmount > model.handlingTotal  %}<span class="is-crossedout" {% block crossedout-inline-style %}{% endblock crossedout-inline-style %}> ( {{model.currencyCode}} {{ model.handlingAmount|floatformat(pageContext.currencyInfo.precision) }} )</span>{% endif %}</span>
              <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.handlingTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
            </td>
        </tr>
        {% endif %}

        <tr class="mz-ordersummary-grandtotal">
            <td colspan="4" class="mz-ordersummary-grandtotal-value">
                <span class="mz-ordersummary-totalname">{{ labels.totalCheckout }}</span>
                {% if model.bluePrepaidCard or model.blueWallet %}
                    {% if model.bluePrepaidCard and model.blueWallet %}
                        <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.total|subtract(model.blueWallet)|subtract(model.bluePrepaidCard)|floatformat(pageContext.currencyInfo.precision) }}</span>
                    {% else %}
                        {% if model.bluePrepaidCard %}
                            <span class="mz-ordersummary-totalvalue" {% if model.bluePrepaidCard and model.blueWallet %} style="display:none;" {% endif %}>{{model.currencyCode}} {{ model.total|subtract(model.bluePrepaidCard)|floatformat(pageContext.currencyInfo.precision) }}</span>
                        {% endif %}
                        {% if model.blueWallet %}
                            <span class="mz-ordersummary-totalvalue" {% if model.bluePrepaidCard and model.blueWallet %} style="display:none;" {% endif %}>{{model.currencyCode}} {{ model.total|subtract(model.blueWallet)|floatformat(pageContext.currencyInfo.precision) }}</span>
                        {% endif %}
                    {% endif %}
                 {% else %}
                 <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.total|floatformat(pageContext.currencyInfo.precision) }}</span>
                 {% endif %}
            </td>
        </tr>
        {% if model.billingInfo %}
        {% if model.billingInfo.digitalCreditPaymentTotal %}
        <tr class="mz-ordersummary-digitalcreditpayment">
          <td colspan="4">
            <span class="mz-ordersummary-totalname">{{ labels.digitalCreditTotal }}</span>
            <span class="mz-ordersummary-totalvalue">{{ labels.digitalCreditSubtractFromOrderPrefix }} {{model.currencyCode}} {{ model.billingInfo.digitalCreditPaymentTotal|floatformat(pageContext.currencyInfo.precision) }}{{ labels.digitalCreditSubtractFromOrderSuffix }}</span>
          </td>
        </tr>
        {% endif %}
        {% if model.billingInfo.giftCardPaymentTotal %}
        <tr class="mz-ordersummary-digitalcreditpayment">
          <td colspan="4">
            <span class="mz-ordersummary-totalname">{{ labels.giftCardTotal }}</span>
            <span class="mz-ordersummary-totalvalue">{{ labels.digitalCreditSubtractFromOrderPrefix }} {{model.currencyCode}} {{ model.billingInfo.giftCardPaymentTotal|floatformat(pageContext.currencyInfo.precision) }}{{ labels.digitalCreditSubtractFromOrderSuffix }}</span>
          </td>
        </tr>
        {% endif %}
        {% if model.billingInfo.digitalCreditPaymentTotal or model.billingInfo.giftCardPaymentTotal %}
        <tr class="mz-ordersummary-grandtotal">
            <td colspan="4">
                <span class="mz-ordersummary-totalname">{{ labels.remainingBalance }}</span>
                <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.billingInfo.nonStoreCreditOrGiftCardTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
            </td>
        </tr>
        {% endif %}
        {% endif %}
        <tr class="mz-edit-bag">
          <td><a href="{{siteContext.siteSubdirectory}}/cart" class="mz-formstep-edit" data-mz-action="editCart">{{ labels.editBag }}</a></td>
          <td></td>
        </tr>
    </tbody>
</table> 
{% require_script "modules/checkout/order-summary-checkout" %}