{% if themeSettings.countrySpecificCode|lower == 'qa' and themeSettings.isQpayApply %}
<label for="paymentType-newPayment-paymentQpay">
<div class="credit-cart-payment rectangle qpay {% if model.isQpayApply and model.paymentType == 'CreditCard' %} mz-payment-selected{% endif %}">
    <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-newcreditcard mz-checkoutform1">
        <div class="credit-debit-card-div">
            <div class="credit-debit-card-div-radio">
                <label class="container-radio">
                    <input data-mz-value="paymentType"
                           data-mz-payment-type
                           name="paymentType"
                           data-mz-cardType='Qpay'
                           id="paymentType-newPayment-paymentQpay"
                           type="radio"
                           class="mz-paymenttype-input mz-credit-card-payment-type"
                           value="CreditCard"
                           {% if model.isQpayApply and model.paymentType == 'CreditCard' %} checked {% endif %}
                           {% if not model.isQpayApply and model.disablePaymentOption %}disabled="disabled"{% endif %} />
                    <span class="checkmark-radio {% if model.isQpayApply and model.paymentType == 'CreditCard' %} checkmark-radio-selected {% endif %}"></span>
                </label>
            </div>

            <div class="credit-debit-card-div-info">
                <img src="{{siteContext.cdnPrefix}}/resources/images/icons/qpay_logo.svg"
                     alt="QPay"
                     class="card-payment qpay-card">
                <div class="card-payment-detail-div">
                    <label for="paymentType-newPayment-paymentQpay"
                           class="mz-paymentselector-label mz-paymentselector-label-newcreditcard mz-checkoutform-radio credit-debit-card">
                        QPay
                    </label>
                    <label for="paymentType-newPayment-paymentQpay" class="use-card-info">
                        {{ labels.payWithQpay }}
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>
</label>
{% endif %}
