{% if themeSettings.isApplePayPaymentApply and window.ApplePaySession %}
<label for="ApplePay-PaymentId">
<div class="credit-cart-payment rectangle {% if model.isApplePayPaymentType and model.paymentType == 'CreditCard' %} mz-payment-selected {% endif %}">
    <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-newcreditcard mz-checkoutform1 ">
        <div class="credit-debit-card-div">
            <div class="credit-debit-card-div-radio">
            <label class="container-radio" for="ApplePay-PaymentId">
                <input data-mz-value="paymentType" data-mz-payment-type name="paymentType" id="ApplePay-PaymentId" rectangle  data-mz-cardType='ApplePay' type="radio" class="mz-paymenttype-input mz-apple-pay-payment-type" value="CreditCard"  {% if model.isApplePayPaymentType and model.paymentType == 'CreditCard' %} checked {% endif %} {% if not model.isApplePayPaymentType and model.disablePaymentOption %}disabled="disabled"{% endif %} />
                    <span class="checkmark-radio {% if model.isApplePayPaymentType and model.paymentType == 'CreditCard' %} checkmark-radio-selected {% endif %}"></span>
                </label>
                
            </div>
            <div>
                <img src="{{siteContext.cdnPrefix}}/resources/images/Apple_Pay_Mark.png" alt="applePay" class="apple-payment-img">
                    <div class="card-payment-detail-div">
                            <label for="ApplePay-PaymentId" class="mz-paymentselector-label mz-paymentselector-label-newcreditcard  mz-checkoutform-radio credit-debit-card" >{{ labels.applePay }}</label>
                            <label for="ApplePay-PaymentId" class="use-card-info">{{labels.useApplePay}}</label>
                    </div>
            </div>
        </div>
    </div>
</div>
</label>
{% endif %}