{% with paymentId|default(0) as paymentId %}
                {% if model.savedPaymentMethods %}
                                        <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-savedcreditcard mz-checkoutform1 ">
                                            <div class="">
                                                <div class=" your-card-details-div">
                                                    <span class="your-card-details"> {{labels.yourCardDetails}}</span>
                                                    <a class="addnewcard">{{ labels.addNewCard }}</a>
                                                </div>
                                                <div class="savecard-select-div">
                                                    {% comment %} <label class="mz-paymentselector-label mz-paymentselector-label-savedcreditcard mz-checkoutform-radio" for="paymentType-savedcreditcard-{{ paymentId }}">{{ labels.savedCreditCard }}</label> {% endcomment %}
                                                    {% comment %} <select {% if not model.usingSavedCard %}disabled="true"{% endif %} name="savedPaymentMethods" class="mz-payment-select-saved-payments saved-pyament-select" data-mz-value="savedPaymentMethodId"> {% endcomment %}
                                                    <select  name="savedPaymentMethods" class="mz-payment-select-saved-payments saved-pyament-select arrows" data-mz-value="savedPaymentMethodId">
                                                        <option selected="selected" value="noCard"> {{ labels.selectSavedCreditCard }}</option>
                                                        {% for card in model.savedPaymentMethods %}
                                                            <option data-card-type="{{card.cardType}}" value="{{ card.id }}" {% if model.savedPaymentMethodId == card.id %} selected="selected" {% endif %}>
                                                                {% with card.cardNumberPartOrMask|replace('*','') as cardNumberEnd%}
                                                                {%if card.expireMonth <10 %}
                                                                {{ labels.cardEnding|string_format(cardNumberEnd) }} {{ labels.exp }} 0{{card.expireMonth }}/{{ card.expireYear|replace('20') }}
                                                                {% else %}
                                                                {{ labels.cardEnding|string_format(cardNumberEnd) }} {{ labels.exp }} {{ card.expireMonth }}/{{ card.expireYear|replace('20') }}
                                                                {% endif %}
                                                                
                                                                {% endwith %}                               
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                    
                                                    {% if model.card %}
                                                      {% if model.card.cardType == "VISA" %}
                                                            <span class="display-image visa-img  {% if model.card.isCardInfoSaved %} card-img {% endif %}" ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/VISA.svg" alt="creditCard"></span>
                                                        {%endif%}
                                                        {% if model.card.cardType == "AMEX" %}
                                                            <span class="display-image amex-img {% if model.card.isCardInfoSaved %} card-img {% endif %}" ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/AmericanExpress-2.svg" alt="creditCard"></span>
                                                        {%endif%}
                                                         {% if model.card.cardType == "MC" %}
                                                            <span class="display-image master-img {% if model.card.isCardInfoSaved %} card-img {% endif %}" ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/Masters.svg" alt="creditCard"></span>
                                                         {%endif%}
                                                         {% if model.card.cardType == "JCB" %}
                                                         <span class="display-image jcb-img {% if model.card.isCardInfoSaved %} card-jcb-img {% endif %}" ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/JCB.svg" alt="creditCard"></span>
                                                        {%endif%}
                                                        {% if model.card.cardType == "EPGCARD" %}
                                                        <span class="cc-img " ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/CreditCard.svg" width="57" height="37" alt="creditCard"></span>
                                                        {%endif%}
                                                         {% if !model.card.cardType %}
                                                         <span class="cc-img " ><img  src="{{siteContext.cdnPrefix}}/resources/images/icons/svg/CreditCard.svg" width="57" height="37" alt="creditCard"></span>
                                                      {%endif%}
                                                    {% comment %} {%else%}
                                                    {% with model.savedPaymentMethods|first as savedCartType %}
                                                        {% if savedCartType.cardType == "VISA" %}
                                                            <span class="display-image visa-img " ><img  src="../../resources/images/icons/svg/VISA.svg" alt="creditCard"></span>
                                                        {%endif%}
                                                        {% if savedCartType.cardType == "AMEX" %}
                                                            <span class="display-image amex-img " ><img  src="../../resources/images/icons/svg/AmericanExpress-2.svg" alt="creditCard"></span>
                                                        {%endif%}
                                                        {% if savedCartType.cardType == "MC" %}
                                                            <span class="display-image master-img " ><img  src="../../resources/images/icons/svg/Masters.svg" alt="creditCard"></span>
                                                        {%endif%}

                                                    {% endwith %} {% endcomment %}

                                                    {%endif%}
                                                    
                                                            {% comment %} {% if model.paymentType == "CreditCard" and model.usingSavedCard %} {% endcomment %}
                                                                {% if not themeSettings.isCvvSuppressed %}
                                                                <div class="mz-paymentselector-reenter-cvv mz-payment-cvv-div">
                                                                    <div class="cvv-label">
                                                                    <label class="mz-paymentselector-label"><b>{{ labels.cvv }}</b><span class="">*</span></label>
                                                                    </div>
                                                                    <div class="cvv-input-div">
                                                                    <input {% if not model.usingSavedCard %}disabled="true"{% endif %} data-mz-saved-cvv type="tel" name="security-code" id="mz-payment-security-code-{{ paymentId }}" class=" card-cvv-saved" data-mz-value="card.cvv" value="{{ model.card.cvv }}" autocomplete="off"/>
                                                                    <img src="{{siteContext.cdnPrefix}}/resources/images/icons/CVV.svg" alt="CVV" class="card-payment-cvv">
                                                                    </div>
                                                                    <span class="mz-validationmessage saved-cvv-validation-msg" data-mz-validationmessage-for="card.cvv"></span>
                                                                </div>
                                                                {% endif %}
                                                            {% comment %} {% endif %} {% endcomment %}
                                                </div>
                                                {% if model.paymentType == "CreditCard" and model.usingSavedCard and model.savedPaymentMethodId %}
                                                {% comment %} <div class="mz-l-stack-section">
                                                    <h4 class="mz-checkoutform-title">{{ labels.billingAddress }}</h4>
                                                    {% include "modules/checkout/billing-address-selector" %}
                                                </div> {% endcomment %}
                                                {% endif %}
                                            </div>
                                        </div>
                                {% endif %} 
                                <div class="test88"></div>
                             {% comment %} <div class="mz-formstep-next save-card-button-div">
                                <button class="save-card-details-btn" data-mz-action="next">{{ labels.saveCardDetails }}</button>
                             </div> {% endcomment %}
                      
    {% comment %} </div>
</div> {% endcomment %}

        
      
    {% comment %} </div> {% endcomment %}


    
    {% comment %} {% if siteContext.checkoutSettings.payByMail %}
    <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-check mz-checkoutform {% if model.paymentType == "Check" %}mz-checkoutform-active{% endif %}">
        <div class="mz-l-formfieldgroup-row">
            <div class="mz-l-formfieldgroup-cell">
                <input data-mz-value="paymentType" data-mz-check data-mz-payment-type id="paymentType-check-{{ paymentId }}" name="paymentType" type="radio" class="mz-paymenttype-input" value="Check" {% if model.paymentType == "Check" %}checked="checked"{% endif %} {% if model.paymentType != "Check" and model.disablePaymentOption %}disabled="disabled"{% endif %} />
            </div>
            <div class="mz-l-formfieldgroup-cell">
                <label class="mz-paymentselector-label mz-paymentselector-label-check mz-checkoutform-radio" for="paymentType-check-{{ paymentId }}">{{ labels.checkByMail }}</label>
            </div>
        </div>
        {% if model.paymentType == "Check" %}
        {% include "modules/checkout/checking-account-form" %}
        <div class="mz-l-stack-section">
            <h4 class="mz-checkoutform-title">{{ labels.billingAddress }}</h4>
            {% include "modules/checkout/billing-address-selector" %}
        </div>
        {% endif %}
    </div>
    {% endif %} {% endcomment %}

    {% comment %} {% with siteContext.checkoutSettings.externalPaymentWorkflowSettings|findwhere("isEnabled", true) as externalPaymentWorkflowsEnabled %}
        {% if externalPaymentWorkflowsEnabled %}
            <div class="mz-l-formfieldgroup-row">
                <div class="mz-paymentselector-label-separator">&ndash; {{ labels.or }} &ndash;</div>
            </div>
            {% for externalPayment in siteContext.checkoutSettings.externalPaymentWorkflowSettings %}
				{% if externalPayment.isEnabled %}
                {% with externalPayment.name|lower as name %}
                    <div class="mz-l-formfieldgroup-row mz-paymentselector-externalworkflows">
                        <div class="mz-l-formfieldgroup-cell">
                        </div>
                        <div class="mz-l-formfieldgroup-cell">
                            {% if name == "visacheckout"%}
                                <div class="mz-digitalwallets">
                                    <img alt="Visa Checkout" class="v-button" role="button"
                                    src="{{pageContext.visaCheckoutButtonUrl}}?size=154&amp;color=neutral"/>
                                </div>
                            {% endif %}
                            {% if name == "paypalexpress2" %}
                                <img id="btn_xpressPaypal" class="p-button" alt="Check out with PayPal" role="button" src="https://www.paypalobjects.com/webstatic/en_US/i/buttons/checkout-logo-medium.png" width="170px" height="32px" align="left" style="margin-right:7px; float:right;"/>
                            {%endif%}
                             {% if name == "paywithamazon" %}
                                <div class="mz-paymenttype" id="amazonButtonPaymentSection">
                                </div>
                             {% endif %}
                             {% if name == "applepay" %}
                             <div class="apple-pay-button" role="button" width="200px" style="display: none" id="applePayButton"></div>
                             {% endif %}
                        </div>
                    </div>
                {% endwith %}
				{% endif %}
            {% endfor %}
        {% endif %}
    {% endwith %}
    <div class="mz-l-formfieldgroup-row mz-paymentselector-validation">
        <div class="mz-formfieldgroup-cell">
        </div>
        <div class="mz-formfieldgroup-cell">
            <span class="mz-validationmessage" data-mz-validationmessage-for="paymentType"></span>
        </div>
    </div> {% endcomment %}
{% comment %} </div> {% endcomment %}

{% endwith %}
