{% if themeSettings.countrySpecificCode|lower == 'kw' and themeSettings.isKNETPaymentApply %}
<label for="paymentType-newPayment-paymentKnet">
<div class="credit-cart-payment rectangle knet {% if model.isKNETPaymentType and model.paymentType == 'CreditCard' %} mz-payment-selected{% endif %}">
    <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-newcreditcard mz-checkoutform1 ">
        <div class="credit-debit-card-div">
            <div class="credit-debit-card-div-radio">
                <label class="container-radio">
                 <input data-mz-value="paymentType" data-mz-payment-type name="paymentType" data-mz-cardType='KNET' id="paymentType-newPayment-paymentKnet" type="radio" class="mz-paymenttype-input mz-credit-card-payment-type" value="CreditCard"  {% if model.isKNETPaymentType and model.paymentType == 'CreditCard' %} checked {% endif %}  {% if not model.isKNETPaymentType and model.disablePaymentOption %}disabled="disabled"{% endif %} />
                    <span class="checkmark-radio {% if model.isKNETPaymentType and model.paymentType == 'CreditCard' %} checkmark-radio-selected {% endif %}"></span>
                </label>
            </div>

            <div class="credit-debit-card-div-info">
                <img src="{{siteContext.cdnPrefix}}/resources/images/icons/knet-icon.svg" alt="cardPayment" class="card-payment knet-card">
                    <div class="card-payment-detail-div">
                             <label for="paymentType-newPayment-paymentKnet"class="mz-paymentselector-label mz-paymentselector-label-newcreditcard  mz-checkoutform-radio credit-debit-card" >KNET</label>
                             <label for="paymentType-newPayment-paymentKnet" class="use-card-info">{{labels.knetRedirectText}}</label>
                    </div>
            </div>
        </div>
    </div>
</div>
</label>

{% endif %}
