<div class=" mz-paymentselector">
    <div class="payment-option-selector"> 
        <div class="choose-payment-div">
            <span class="forDesktopPay">{{labels.choosePaymentMethod}}</span>
            <span class="forMobilePay">{{labels.choosePayment}}</span>
        </div>
        {%include "modules/checkout/blue-pay-selector"%}
        {% include "modules/checkout/apple-pay-selector"%}
        {% include "modules/checkout/checkout-knet-card-payment"%}
        {% include "modules/checkout/checkout-benefitpay-card-payment"%}
        {% include "modules/checkout/checkout-qpay-card-payment"%}
        {% include "modules/checkout/checkout-omannet-card-payment"%}
        <div class="credit-cart-payment rectangle  {% if model.isCreditCardPayment %}mz-payment-selected{% endif %}">
            <div class="mz-l-formfieldgroup-row mz-paymentselector-option mz-paymentselector-newcreditcard test10 mz-checkoutform1 ">
                <div class="credit-debit-card-div">
                   <div class="credit-debit-card-div-radio">
                        <label class="container-radio">
                        <input data-mz-value="paymentType" data-mz-new-credit-card data-mz-payment-type id="paymentType-newcreditcard-{{ paymentId }}" name="paymentType" type="radio" class="mz-paymenttype-input" value="CreditCard"  {% if model.paymentType == "CreditCard" and model.isCreditCardPayment  %} checked {% endif %} {% if not model.isCreditCardPayment and model.disablePaymentOption %}disabled="disabled"{% endif %}/>
                        <span class="checkmark-radio"></span>
                    </label>
                    </div>
                    <div>
                        <img src="{{siteContext.cdnPrefix}}/resources/images/icons/CardPayment.svg" alt="cardPayment" class="card-payment">
                        <div class="card-payment-detail-div">
                            <label class="mz-paymentselector-label mz-paymentselector-label-newcreditcard  mz-checkoutform-radio credit-debit-card" for="paymentType-newcreditcard-{{ paymentId }}">{% if model.savedPaymentMethods %}{{ labels.creditDebitCard }}{% else %}{{ labels.creditDebitCard }}{% endif %}</label>
                            <label class="use-card-info">{{labels.useCard}}</label>
                        </div>
                    
                    </div>
                </div>
                {% if model.isCreditCardPayment and model.paymentType == "CreditCard" %}
                        {% if model.usingSavedCard %}
                        <div class="card-payment-main-container test1000 ">
                            {% if model.showNewAddress %}
                                <div class="mz-payment-new-card-add hidden test100">
                                     {% include "modules/checkout/add-new-card-payment" with model=model %}
                                </div>
                            {% else %} 
                                <div class="mz-payment-new-card-add-extra hidden"> 
                                     {% include "modules/checkout/add-new-card-payment" with model=model %}
                                </div>
                            {% endif%}
                            {% if  model.showSavedCardForm %}
                            <div class="mz-l-stack-section checkout-payment-saved-cards  ">
                                {% if model.savedPaymentMethods %}
                                {% include "modules/checkout/payment-selector-saved-cards" %}
                                {% else %}
                                {% if model.showNewAddress %}
                                    <div class="mz-payment-new-card-add test10012">
                                       {% include "modules/checkout/add-new-card-payment" with model=model %}
                                    </div>
                                {% endif %}
                                {%endif%}
                            </div>
                            {%else%}
                            <div class="mz-l-stack-section checkout-payment-saved-cards-extra hidden">
                                {% include "modules/checkout/payment-selector-saved-cards" %}
                            </div>
                            {%endif%}
                                    {% comment %} {% if model.visaCheckoutFlowComplete %}
                                    <a class="mz-checkout-payment-change" href="javascript:;" data-mz-action="beginEditingCard">{{ labels.removePayment }}</a>
                                {% else %}
                                    <a class="mz-checkout-payment-change" href="javascript:;" data-mz-action="beginEditingCard">{{ labels.change }}</a>
                                {% endif %}
                                    <p>{{ model.card.paymentOrCardType }} {{ model.card.cardNumberPartOrMask }}
                                    <br/>{{ labels.expires }} {{ model.card.expireMonth }}/{{ model.card.expireYear }}</p>
                                {% if not themeSettings.isCvvSuppressed %}
                                    <div class="mz-l-formfieldgroup">
                                    <div class="mz-l-formfieldgroup-row mz-payment-credit-card-securitycode-row">
                                        <div class="mz-l-formfieldgroup-cell">
                                            <label for="mz-payment-security-code">{{ labels.securityCode }}<span class="is-required"> *</span>:</label>
                                        </div>
                                        <div class="mz-l-formfieldgroup-cell">
                                            <input type="tel" name="security-code" id="mz-payment-security-code" class="mz-l-formfieldgroup-halfsize" data-mz-value="card.cvv" value="{{ model.card.cvv }}" autocomplete="off"/>
                                            <span class="mz-validationmessage" data-mz-validationmessage-for="card.cvv"></span>
                                        </div>
                                    </div>
                                    </div>
                                {% endif %} {% endcomment %}
                                {% comment %} <div class="mz-formstep-next save-card-button-div">
                                    <button class="save-card-details-btn" data-mz-action="next">{{ labels.saveCardDetails }}</button>
                                </div> {% endcomment %}
                        </div>

                        {%else%}
                        <div class="card-payment-main-container test10001 ">
                            {% if model.showNewAddress %}
                            
                                <div class="mz-payment-new-card-add test100">
                                {% include "modules/checkout/add-new-card-payment" with model=model %}
                                </div>
                    
                             {%endif%}
                        {% if  model.showSavedCardForm %}
                        <div class="mz-l-stack-section checkout-payment-saved-cards hidden ">
                            {% if model.savedPaymentMethods %}
                            {% include "modules/checkout/payment-selector-saved-cards" %}
                            {% else %}
                            {% if model.showNewAddress %}
                                <div class="mz-payment-new-card-add test10012">
                                    {% include "modules/checkout/add-new-card-payment" with model=model %}
                                </div>
                            {% endif %}
                            {%endif%}
                        </div>
                        {% endif %}
                    </div>
                {%endif%}

                {% endif %}
            </div>
        </div>
        {%include "modules/checkout/cod-pay-selector"%}
    </div>
</div>