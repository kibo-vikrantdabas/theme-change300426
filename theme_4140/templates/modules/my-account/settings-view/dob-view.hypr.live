<div class="mz-accountsettings-dob">
    <label class="mz-account-settings-label-name">{{ labels.dateOfBirth }} 
      <span class="help-info"></span>
      <span class="info-box gender-info-detail">{{labels.ageDescription|safe}}</span>
    </label>
    <div class="input-holder">
      <select id="day" data-mz-value="dayOfBirth" name="dayOfBirth">
        <option value>{{labels.dd}}</option>
        {% for day  in  themeSettings.dayOfBirth %}
          <option value="{{day}}" {% if model.dayOfBirth == day %} selected {% endif %}>{{day}}</option> 
        {% endfor %}
      </select>

      <span>/</span>

      <select name="" id="month" data-mz-value="monthOfBirth" name="monthOfBirth">
        <option value>{{labels.mm}}</option>
        {% for month  in  themeSettings.monthOfBirth %}
          <option value="{{month}}" {% if model.monthOfBirth == month %} selected {% endif %}>{{month}}</option> 
        {% endfor %}
      </select>
      
    <span>/</span>
    <select name="" id="year" data-mz-value="yearOfBirth" name="yearOfBirth">
      <option value>{{labels.yyyy}}</option>
      {% for year  in  themeSettings.yearOfBirth %}
          <option value="{{year}}" {% if model.yearOfBirth == year %} selected {% endif %}>{{year}}</option> 
      {% endfor %}
      {% comment %} <option value="2022">2022</option> {% endcomment %}
      {% comment %} <option value="2021">2021</option><option value="2020">2020</option><option value="2019">2019</option><option value="2018">2018</option>
      <option value="2017">2017</option><option value="2016">2016</option><option value="2015">2015</option><option value="2014">2014</option>
      <option value="2013">2013</option><option value="2012">2012</option><option value="2011">2011</option><option value="2010">2010</option>
      <option value="2009">2009</option> <option value="2008">2008</option> <option value="2007">2007</option> <option value="2006">2006</option> 
      <option value="2005">2005</option> <option value="2004">2004</option> <option value="2003">2003</option> <option value="2002">2002</option>
       <option value="2001">2001</option> <option value="2000">2000</option> <option value="1999">1999</option><option value="1998">1998</option>
       <option value="1997">1997</option><option value="1996">1996</option><option value="1995">1995</option><option value="1994">1994</option>
       <option value="1993">1993</option><option value="1992">1992</option><option value="1991">1991</option><option value="1990">1990</option>
       <option value="1989">1989</option><option value="1988">1988</option><option value="1987">1987</option><option value="1986">1985</option>
       <option value="1984">1984</option><option value="1983">1983</option><option value="1982">1982</option><option value="1981">1981</option>
       <option value="1980">1980</option><option value="1979">1979</option><option value="1978">1978</option><option value="1977">1977</option>
       <option value="1976">1976</option><option value="1975">1975</option><option value="1974">1974</option><option value="1973">1973</option>
       <option value="1972">1972</option><option value="1971">1971</option><option value="1970">1970</option> {% endcomment %}
     </select>
    </div>
  </div>