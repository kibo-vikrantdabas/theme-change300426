<div class="change-password-section">
<h3 class="mz-l-stack-sectiontitle">{{ labels.changePassword }}</h3>
<div class="change-password-error messaging error-msg hidden" >
	<ul>
    <li >	
		</li>
	</ul>
</div>
<p class="mz-change-password-below">{{ labels.changePasswordText }}</p>

<div class="mz-accountsettings-password">
  <div class="mz-validationmessage mz-passwordChanged-msg" data-mz-validationmessage-for="passwordChanged"></div>
  <div class="account-old-passowrd-error-msg hidden">
    <label for="account-oldpassword" class="mz-accountsettings-newpasswordlabel notxt"></label>
    <div class="inline-error-message">
        <span class="error-message"></span>
        <span class="inline-error-message-arrow"></span>
    </div>
  </div>
  <div>
    <label for="account-oldpassword" class="mz-accountsettings-currentpasswordlabel">{{ labels.currentPassword }}</label>
    <input id="account-oldpassword" class="mz-accountsettings-currentpassword" type="password" data-mz-value="oldPassword" value="{{ model.oldPassword }}" />
    <a id="eye-current-password" class="eye">
      <span class="eye-open eye-text"><img class="eye-image" alt="eyeopen" src="{{siteContext.cdnPrefix}}/resources/images/icons/Eye.svg"> {{ labels.show }}</span>
      <span class="eye-close eye-text hidden"><img class="eye-image" alt="eyehidden" src="{{siteContext.cdnPrefix}}/resources/images/icons/EyeHidden.svg"> {{ labels.hide }}</span>
    </a>
  </div>
  
  <div class="account-passowrd-error-msg hidden">
    <label for="account-password" class="mz-accountsettings-newpasswordlabel notxt"></label>
    <div class="inline-error-message">
        <span class="error-message"></span>
        <span class="inline-error-message-arrow"></span>
    </div>
  </div>
  <div>
    <label for="account-password" class="mz-accountsettings-newpasswordlabel">{{ labels.newPassword }}</label>
    <input id="account-password" class="mz-accountsettings-newpassword" type="password" data-mz-value="password" value="{{ model.password }}" />
    <a id="eye-new-password" class="eye">
      <span class="eye-open eye-text"><img class="eye-image" alt="eyeopen" src="{{siteContext.cdnPrefix}}/resources/images/icons/Eye.svg"> {{ labels.show }}</span>
      <span class="eye-close eye-text hidden"><img class="eye-image" alt="eyehidden" src="{{siteContext.cdnPrefix}}/resources/images/icons/EyeHidden.svg"> {{ labels.hide }}</span>
    </a>
  </div>  
  <div>
  <label for="account-password" class="mz-accountsettings-newpasswordlabel notxt"></label>
  <p>{{labels.passwordValidationMsg}}</p>
</div>  
<div class="account-confirm-passowrd-error-msg hidden">
    <label for="account-confirmpassword" class="mz-accountsettings-newpasswordlabel notxt"></label>
    <div class="inline-error-message">
        <span class="error-message"></span>
        <span class="inline-error-message-arrow"></span>
    </div>
  </div>  
  <div>
    <label for="account-confirmpassword" class="mz-accountsettings-confirmpasswordlabel">{{ labels.confirmPassword }}</label>
    <input id="account-confirmpassword" class="mz-accountsettings-confirmpassword" type="password" data-mz-value="confirmPassword" value="{{ model.confirmPassword }}" />
    <a id="eye-confirm-password" class="eye">
      <span class="eye-open eye-text"><img class="eye-image" alt="eyeopen" src="{{siteContext.cdnPrefix}}/resources/images/icons/Eye.svg"> {{ labels.show }}</span>
      <span class="eye-close eye-text hidden"><img class="eye-image" alt="eyehidden" src="{{siteContext.cdnPrefix}}/resources/images/icons/EyeHidden.svg"> {{ labels.hide }}</span>
    </a>
  </div>
  
  <div class="mz-password-actions">
    <div class="mz-validationmessage" data-mz-validationmessage-for="oldPassword"></div>
    <div class="mz-validationmessage" data-mz-validationmessage-for="password"></div>
    <div class="mz-validationmessage" data-mz-validationmessage-for="confirmPassword"></div>
    <button id="savepwd" class="mz-button mz-button-small mz-accountsettings-passworddone" data-mz-action="finishEditPassword">{{ labels.save }}</button>
    {% comment %} <button class="mz-button mz-button-small mz-accountsettings-passwordcancel" data-mz-action="cancelEditPassword">{{ labels.cancel }}</button> {% endcomment %}
  </div>
  
  <button class="mz-button mz-button-small mz-accountsettings-passwordedit hidden" data-mz-action="startEditPassword">{{ labels.changePassword }}</button>
  
</div>
</div>