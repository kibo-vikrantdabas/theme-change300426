<div class="mz-confirmation-billing-summary">
  <div class="mz-placed-order-day">
    <span class="mz-placed-order-text">{{ labels.placedOrderDate }}</span>
    <span class="mz-placed-order-date"></span>{{ model.submittedDate|date:"D, d M Y" }}</div>
  <div class="mz-ordersummary-subtotal">
    <div colspan="4" class="mz-ordersummary-values">
      <span class="mz-ordersummary-totalname">{{ labels.subtotal }}</span>
      <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.subtotal|floatformat(pageContext.currencyInfo.precision) }}</span>
    </div>
  </div> 
{% for item in model.items %}
  {% for productDiscount in item.productDiscounts %}
    {% if productDiscount %}
      <div class="mz-ordersummary-discount">
        <div colspan="4" class="mz-ordersummary-values">
          <span class="mz-ordersummary-discountname">{% comment %}{{ productDiscount.discount.name }}{% endcomment %}{{labels.promotionCode}}</span>
            {% if productDiscount.discount.freeShipping %}
              <span class="mz-item-discountamt">{{ labels.freeShipping }}</span>
            {% else %}
            <span class="mz-item-discountamt">- {{model.currencyCode}} {{ productDiscount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
            {% endif %}
          {% comment %} <span class="mz-ordersummary-discountamt">- {{model.currencyCode}} {{ discount.impact|floatformat(pageContext.currencyInfo.precision) }}</span> {% endcomment %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endfor %}
{% for discount in model.orderDiscounts %}
{% if not discount.excluded %}
<div class="mz-ordersummary-discount">
  <div colspan="4" class="mz-ordersummary-values">
    <span class="mz-ordersummary-discountname">{% comment %}{{ discount.discount.name }}{% endcomment %}{{labels.promotionCode}}</span>
    <span class="mz-ordersummary-discountamt">- {{model.currencyCode}} {{ discount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
  </div>
</div>
{% endif %}
{% endfor %}

{% if model.dutyTotal > 0 %}
<div class="mz-ordersummary-tax">
  <div colspan="4" class="mz-ordersummary-values">
    <span class="mz-ordersummary-totalname">{{ labels.taxDuty }}</span>
    <span class="mz-ordersummary-totalvalue">{% filter currency %} {{ model.dutyTotal|add(model.taxTotal)}} {% endfilter %}</span>
  </div>
</div>
{% else %}
{% if model.taxTotal > 0 %}
<div class="mz-ordersummary-tax">
    <div colspan="4" class="mz-ordersummary-values">
        <span class="mz-ordersummary-totalname">{{ labels.tax }}</span>
        <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.taxTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
    </div>
</div>
{% endif %}
{% endif %}

<div class="mz-ordersummary-shippingtotal">
    <div colspan="4" class="mz-ordersummary-values">
      <span class="mz-ordersummary-totalname">{{ labels.deliveryCost }}</span>
      {% if model.shippingSubTotal == 0 or model.shippingSubTotal == null %}
        <span class="mz-ordersummary-totalvalue">{{ labels.free }}</span>
      {% else %}
        <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.shippingSubTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
      {% endif %}
    </div>
  </div>
  {% for shippingDiscount in model.shippingDiscounts %}
  <div class="mz-ordersummary-shippingdiscount">
    <div colspan="4" class="mz-ordersummary-values">
      <span class="mz-ordersummary-totalname">{{ shippingDiscount.discount.discount.name }}</span>
      <span class="mz-ordersummary-totalvalue">- {{model.currencyCode}} {{ shippingDiscount.discount.impact|floatformat(pageContext.currencyInfo.precision) }}</span>
    </div>
  </div>
  {% endfor %}
  {% if model.handlingTotal > 0%}
  <div class="mz-ordersummary-additionalhandling">
      <div colspan="4" class="mz-ordersummary-values">
        <span class="mz-ordersummary-totalname">{{ labels.additionalHandling }}{% if model.handlingAmount > model.handlingTotal  %}<span class="is-crossedout" {% block crossedout-inline-style %}{% endblock crossedout-inline-style %}> ( {{model.currencyCode}} {{ model.handlingAmount|floatformat(pageContext.currencyInfo.precision) }} )</span>{% endif %}</span>
        <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.handlingTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
      </div>
  </div>
  {% endif %}

  <div class="mz-ordersummary-grandtotal">
      <div colspan="4" class="mz-ordersummary-grand-values">
          <span class="mz-ordersummary-totalname">{{ labels.orderTotal }}</span>
          <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.total|floatformat(pageContext.currencyInfo.precision) }}</span>
      </div>
  </div>
  <div class="mz-ordersummary-VatTotal"></div>
  {% if model.billingInfo %}
  {% if model.billingInfo.digitalCreditPaymentTotal %}
  <div class="mz-ordersummary-digitalcreditpayment">
    <div colspan="4" class="mz-ordersummary-values">
      <span class="mz-ordersummary-totalname">{{ labels.digitalCreditTotal }}</span>
      <span class="mz-ordersummary-totalvalue">{{ labels.digitalCreditSubtractFromOrderPrefix }} {{model.currencyCode}} {{ model.billingInfo.digitalCreditPaymentTotal|floatformat(pageContext.currencyInfo.precision) }} {{ labels.digitalCreditSubtractFromOrderSuffix }}</span>
    </div>
  </div>
  {% endif %}
  {% if model.billingInfo.giftCardPaymentTotal %}
  <div class="mz-ordersummary-digitalcreditpayment">
    <div colspan="4" class="mz-ordersummary-values">
      <span class="mz-ordersummary-totalname">{{ labels.giftCardTotal }}</span>
      <span class="mz-ordersummary-totalvalue">{{ labels.digitalCreditSubtractFromOrderPrefix }} {{model.currencyCode}} {{ model.billingInfo.giftCardPaymentTotal|floatformat(pageContext.currencyInfo.precision) }} {{ labels.digitalCreditSubtractFromOrderSuffix }}</span>
    </div>
  </div>
  {% endif %}
  {% if model.billingInfo.digitalCreditPaymentTotal or model.billingInfo.giftCardPaymentTotal %}
  <div class="mz-ordersummary-grandtotal">
      <div colspan="4" class="mz-ordersummary-values">
          <span class="mz-ordersummary-totalname">{{ labels.remainingBalance }}</span>
          <span class="mz-ordersummary-totalvalue">{{model.currencyCode}} {{ model.billingInfo.nonStoreCreditOrGiftCardTotal|floatformat(pageContext.currencyInfo.precision) }}</span>
      </div>
  </div>
  {% endif %}
  {% endif %}
</div>