{% extends "modules/common/item-listing" %}
{% block module-classes %}mz-itemlisting-autocomplete mz-itemlisting-autocomplete-product{% endblock module-classes %}

{% block item-listing-image %}
<div class="mz-itemlisting-thumb">
    {% with model.productImageUrls|first as image %}
    {% if image %}
    <img class="mz-itemlisting-thumb-img" src="{% make_url "image" image with max=80 as_parameters %}" {% if image.altText %}alt="{{ image.altText }}"{% endif %} />
    {% endif %}
    {% endwith %}
</div>
{% endblock %}

{% block item-name %}
    <a class="mz-itemlisting-title" href="javascript:;" onclick="window.globalEventBus.emit('searchedKeywordEvent', {'custom_event': 'internal searches', 'event_params':{'event_act': 'suggested searches','event_lbl': '{% if model.productCategoryNames %} {{ model.productName|lower }} in {{model.productCategoryNames|first}} {% else %} {{ model.productName|lower }} {% endif %}'}})">{% if model.productCategoryNames %} {{ model.productName|lower }} in {{model.productCategoryNames|first}} {% else %} {{ model.productName|lower }} {% endif %}</a>
{% endblock item-name %}


{% block item-details %}
<div class="mz-itemlisting-description">
    {{ model.content.productShortDescription|truncatewords(20)|safe }}
</div>
{% endblock %}