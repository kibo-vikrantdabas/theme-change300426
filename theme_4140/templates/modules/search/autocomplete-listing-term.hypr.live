{% extends "modules/common/item-listing" %}
{% block module-classes %}mz-itemlisting-autocomplete mz-itemlisting-autocomplete-product{% endblock module-classes %}

{% block item-listing-image %}

{% endblock %}
{% block item-name %}
    <a class="mz-itemlisting-title" href="javascript:;" onclick="window.globalEventBus.emit('searchedKeywordEvent', {'custom_event': 'internal searches', 'event_params':{'event_act': 'suggested searches','event_lbl': '{% if model.term %}{{ model.term|lower }}{% endif %}'}})"> {{ model.term|lower }} </a>
{% endblock item-name %}


{% block item-details %}

{% endblock %}