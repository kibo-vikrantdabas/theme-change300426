{% if model.onSale %}
 <span itemprop="price" class="mz-price is-saleprice">
    {% if model.priceType != "MAP" %}
        <span class="currency-code"> {% include "modules/common/currency-code" %} </span> {{model.salePrice|floatformat(pageContext.currencyInfo.precision)}}
    {% else %}
         <div>{{ labels.mapPrice }}</div>
    {% endif %}

    {% if model.discount.discounts.length %}
        <div class="discountedPrice discount-price-pdp-hide">
        {% for discount in model.discount.discounts %}
            <span class="mz-product-promotions-offer-discount">{{discount.name}}</span>
        {% endfor %}
        </div>
    {% endif %}
 </span>
 <span class="mz-price is-crossedout">
    <span class="currency-code"> {% include "modules/common/currency-code" %} </span> {{model.price|floatformat(pageContext.currencyInfo.precision)}}
 </span>
 {% else %}
 <span itemprop="price" class="mz-price">

     {% if model.priceType != "MAP" %}
       <span class="currency-code"> {% include "modules/common/currency-code" %} </span> {{model.price|floatformat(pageContext.currencyInfo.precision)}}
     {% else %}
         <span class="mz-price is-crossedout">
         {{model.price|currency}}
         </span>
         <div>{{ labels.mapPrice }}</div>
     {% endif %}
 </span>
 {% endif %}
 {% if themeSettings.showMSRP and model.msrp %}
 <span class="mz-price-msrp">{{ labels.msrp}}: <span class="mz-price">{{ model.msrp|currency }}</span></span>
 {% endif %}